# Allowed unconditionally: every table entry except the four special ones.
_SECCOMP_ALLOW = tuple(sorted(
    (n for n in _SECCOMP_X86_64 if n not in ("socket", "ioctl", "clone",
                                             "clone3")),
    key=_SECCOMP_X86_64.get))

# socket(domain, ...): AF_UNIX, AF_INET, AF_INET6 only. Everything else --
# AF_NETLINK, AF_PACKET, AF_ALG, AF_VSOCK, ... -- is kernel surface a CLI does
# not need (glibc falls back cleanly when a netlink socket is refused).
_SECCOMP_SOCKET_DOMAINS = (1, 2, 10)
# ioctl(fd, cmd, ...): TIOCSTI and TIOCLINUX push bytes into a terminal's input
# queue -- a contained process could type commands into the shell that started
# sbx. bwrap's --new-session already removes the controlling tty; this deny is
# defence in depth. Checked on the low 32 bits, which is all the kernel reads of
# `cmd`.
_SECCOMP_IOCTL_DENY = (0x5412, 0x541C)
# clone(flags, ...): any CLONE_NEW{NS,CGROUP,UTS,IPC,USER,PID,NET} is refused,
# which is what makes the omitted unshare/setns mean something. clone3 passes
# its flags in a struct seccomp cannot read, so it gets ENOSYS: glibc (and every
# runtime that uses clone3) then falls back to the checked clone.
_SECCOMP_CLONE_NS_MASK = 0x7E020000

# classic-BPF opcodes (linux/filter.h) and seccomp return actions (seccomp.h).
_BPF_LD_W_ABS = 0x20
_BPF_JEQ_K = 0x15
_BPF_JSET_K = 0x45
_BPF_RET_K = 0x06
_SECCOMP_RET_KILL_PROCESS = 0x80000000
_SECCOMP_RET_ERRNO = 0x00050000
_SECCOMP_RET_ALLOW = 0x7FFF0000
_EPERM = 1
_ENOSYS = 38
_X32_SYSCALL_BIT = 0x40000000
# offsets into struct seccomp_data {int nr; u32 arch; u64 ip; u64 args[6];};
# an argument is read by its LOW 32 bits, which on little-endian x86_64 sit at
# the start of the 8-byte slot.
_SD_NR, _SD_ARCH, _SD_ARG0, _SD_ARG1 = 0, 4, 16, 24


def seccomp_program(machine):
    """Pure: the seccomp BPF allowlist for `machine` (uname -m) as the bytes of a
    struct sock_filter[] array, or ValueError when no table exists for it.

    Layout, top to bottom:
      load arch; != this machine's AUDIT_ARCH -> KILL_PROCESS
      load nr;   x32 bit set                  -> KILL_PROCESS
      socket -> load arg0; AF_UNIX/INET/INET6 -> ALLOW, else EPERM
      ioctl  -> load arg1; TIOCSTI/TIOCLINUX  -> EPERM, else ALLOW
      clone  -> load arg0; any CLONE_NEW* bit -> EPERM, else ALLOW
      clone3                                  -> ENOSYS
      one `nr == N -> ALLOW` pair per allowlisted syscall, in number order
      default                                 -> ERRNO(EPERM)
    Every conditional block ends in its own RET, so the accumulator never has to
    be reloaded and every jump is 0 or a short forward skip (classic BPF jump
    offsets are one byte). Packed little-endian "<HBBI" -- the only table is
    x86_64 -- so the bytes are the same on whatever host builds them.
    """
    arch = _AUDIT_ARCH.get(machine) if isinstance(machine, str) else None
    if arch is None:
        raise ValueError(
            "no seccomp syscall table for machine %r (only %s is built)"
            % (machine, ", ".join(sorted(_AUDIT_ARCH))))
    nr = _SECCOMP_X86_64
    deny = _SECCOMP_RET_ERRNO | _EPERM
    allow = _SECCOMP_RET_ALLOW
    insns = [
        (_BPF_LD_W_ABS, 0, 0, _SD_ARCH),
        (_BPF_JEQ_K, 1, 0, arch),
        (_BPF_RET_K, 0, 0, _SECCOMP_RET_KILL_PROCESS),
        (_BPF_LD_W_ABS, 0, 0, _SD_NR),
        (_BPF_JSET_K, 0, 1, _X32_SYSCALL_BIT),
        (_BPF_RET_K, 0, 0, _SECCOMP_RET_KILL_PROCESS),
    ]

    def block(name, body):
        # `nr == name` falls into body (which ends in a RET); otherwise skip it.
        insns.append((_BPF_JEQ_K, 0, len(body), nr[name]))
        insns.extend(body)

    body = [(_BPF_LD_W_ABS, 0, 0, _SD_ARG0)]
    for domain in _SECCOMP_SOCKET_DOMAINS:
        body += [(_BPF_JEQ_K, 0, 1, domain), (_BPF_RET_K, 0, 0, allow)]
    block("socket", body + [(_BPF_RET_K, 0, 0, deny)])

    body = [(_BPF_LD_W_ABS, 0, 0, _SD_ARG1)]
    for cmd in _SECCOMP_IOCTL_DENY:
        body += [(_BPF_JEQ_K, 0, 1, cmd), (_BPF_RET_K, 0, 0, deny)]
    block("ioctl", body + [(_BPF_RET_K, 0, 0, allow)])

    block("clone", [(_BPF_LD_W_ABS, 0, 0, _SD_ARG0),
                    (_BPF_JSET_K, 0, 1, _SECCOMP_CLONE_NS_MASK),
                    (_BPF_RET_K, 0, 0, deny),
                    (_BPF_RET_K, 0, 0, allow)])
    block("clone3", [(_BPF_RET_K, 0, 0, _SECCOMP_RET_ERRNO | _ENOSYS)])

    for name in _SECCOMP_ALLOW:
        block(name, [(_BPF_RET_K, 0, 0, allow)])
    insns.append((_BPF_RET_K, 0, 0, deny))
    return b"".join(struct.pack("<HBBI", *insn) for insn in insns)


def _host_machine():
    """The kernel's machine name (`uname -m`). A function of its own so the
    offline suite can stand in a foreign machine without patching os.uname for
    the whole test process."""
    return os.uname().machine


def _seccomp_refuse(reason):
    """One line to stderr and exit 3: --seccomp was asked for and cannot be
    honoured, so NOTHING runs -- never the same command without the filter."""
    sys.stderr.write(
        "sbx: error: --seccomp: %s; refusing to run without the requested "
        "syscall filter (fail-closed)\n" % (reason,))
    sys.exit(3)


def _seccomp_fd():
    """Build the program for THIS host and hand it to bwrap on an inheritable fd;
    return the fd NUMBER. The one I/O site of the seccomp layer -- called from
    main() only, after the engine is resolved and before the pure builder runs.

    Fail-closed on every path: a non-Linux platform (Seatbelt has no seccomp), a
    machine with no table, or a host that cannot create the memfd all refuse.

    A memfd rather than a pipe: bwrap reads the fd to EOF after sbx has exec'd it,
    so the whole program must already be in the fd, and a pipe's capacity drops
    to a single 4 KiB page once the user exceeds pipe-user-pages-soft -- a
    program that size would block the write forever. The memfd has no such
    ceiling; it is rewound to offset 0 so bwrap reads it from the start, and it
    is created WITHOUT MFD_CLOEXEC and marked inheritable so it survives the exec.
    """
    platform = _platform_key(sys.platform)
    if platform != "linux":
        _seccomp_refuse("it is a Linux (bwrap) syscall filter and this platform "
                        "is %r" % (sys.platform,))
    try:
        program = seccomp_program(_host_machine())
    except ValueError as exc:
        _seccomp_refuse(str(exc))
    memfd_create = getattr(os, "memfd_create", None)
    if memfd_create is None:
        _seccomp_refuse("this Python has no os.memfd_create to carry the program")
    try:
        fd = memfd_create("sbx-seccomp", 0)
        view = memoryview(program)
        while view:
            view = view[os.write(fd, view):]
        os.lseek(fd, 0, os.SEEK_SET)
        os.set_inheritable(fd, True)
    except OSError as exc:
        _seccomp_refuse("cannot write the program to a memfd: %s" % (exc,))
    return fd


def _file_mask_fds(secrets):
    """One inheritable fd on /dev/null per FILE secret, in order -- the empty
    source of each `--ro-bind-data` mask. Called from main() only, so _bwrap_argv
    stays pure."""
    fds = []
    for _secret, is_dir in secrets or ():
        if not is_dir:
            fds.append(os.open(os.devnull, os.O_RDONLY))
            os.set_inheritable(fds[-1], True)
    return tuple(fds)


# ---------------------------------------------------------------------------
# Bounded blast radius (task-006 / R19 / NFR-5): the resource limits' SINGLE
# source (KD-2). These ceilings are applied to THIS process immediately BEFORE
# os.execvp (KD-4) so the exec-replaced target inherits them. They are pure
# module-level constants -- no I/O at import (M3); the setrlimit calls that read
# them happen only at runtime, from _apply_rlimits(), behind the __main__ guard.
_RLIMIT_AS_BYTES = 8 * 1024 ** 3        # 8 GiB of address space per process
_RLIMIT_CPU_SECONDS = 900               # 15 minutes of CPU time
# RLIMIT_NPROC is PER-UID (see the caveat in _apply_rlimits): when NO per-UID
# ceiling exists at all (RLIM_INFINITY) we impose this generous headroom rather
# than a small absolute cap that would spuriously fail an innocent command.
_RLIMIT_NPROC_HEADROOM = 512


def _apply_rlimits():
    """Set RLIMIT_AS / RLIMIT_CPU / RLIMIT_NPROC on THIS process -- called ONLY
    from main()'s real-run path, immediately BEFORE os.execvp.

    *** ORDERING IS LOAD-BEARING (KD-4): setrlimit MUST run BEFORE os.execvp. ***
    os.execvp replaces the process IMAGE but keeps the SAME PID, and resource
    limits SURVIVE exec, so the sandboxed target inherits every limit set here.
    After execvp this code never runs, so the limits are established here,
    immediately before the exec -- never after (there is no "after").

    Best-effort / non-raising: the soft limit is clamped to the current hard
    limit (an unprivileged process may only LOWER a hard limit) and the hard
    limit is preserved; a limit the platform rejects is skipped rather than
    bricking an already OS-sandboxed run. rlimits are a robustness backstop
    against a runaway (fork/mem bomb, R19), NOT the containment boundary -- the
    OS sandbox is.
    """
    def _lower_to(which, desired):
        try:
            _soft, hard = resource.getrlimit(which)
        except (OSError, ValueError):
            return
        if hard != resource.RLIM_INFINITY:
            desired = min(desired, hard)     # never RAISE the existing hard cap
        try:
            resource.setrlimit(which, (desired, hard))
        except (OSError, ValueError):
            pass                             # platform refused it; skip, don't brick

    for name, desired in (("RLIMIT_AS", _RLIMIT_AS_BYTES),
                          ("RLIMIT_CPU", _RLIMIT_CPU_SECONDS)):
        which = getattr(resource, name, None)
        if which is not None:
            _lower_to(which, desired)

    # RLIMIT_NPROC PER-UID CAVEAT: RLIMIT_NPROC counts ALL of the invoking user's
    # processes, not merely this sandbox's descendants. A small ABSOLUTE cap (say
    # 64) would spuriously fail an innocent command the instant the user's
    # EXISTING process count already exceeds it -- so we never impose a small
    # absolute number. The ideal is a modest HEADROOM above the current process
    # count (leaving room for the engine to fork its target), but the stdlib has
    # no portable per-UID process count, so we do NOT tighten below the working
    # per-UID soft cap (which already bounds a fork bomb and under which every
    # innocent command already runs); we merely keep it FINITE, imposing a
    # generous headroom only when there is no ceiling at all. This is a
    # ROBUSTNESS caveat, NOT a containment hole -- the OS sandbox is the boundary;
    # NPROC only blunts a fork bomb (R19).
    nproc = getattr(resource, "RLIMIT_NPROC", None)
    if nproc is None:
        return
    try:
        soft, hard = resource.getrlimit(nproc)
    except (OSError, ValueError):
        return
    target = _RLIMIT_NPROC_HEADROOM if soft == resource.RLIM_INFINITY else soft
    try:
        resource.setrlimit(nproc, (target, hard))
    except (OSError, ValueError):
        pass


# ---------------------------------------------------------------------------
# Restricted mode: strict rlimits, the exec triple and the supervisor (ADR 0031,
# plan Step 4). Nothing here runs at import; every function is called from
# main() only, and only when a restricted flag asks for it -- a legacy
# invocation reaches none of them (sbx_gate row Q, _main_in).

def uid_process_count(uid):
    """The number of the uid's RLIMIT_NPROC units -- the base of the
    `--rlimit-nproc +N` form (RLIMIT_NPROC counts everything of the uid, not
    only this run's). I/O, called from the supervisor or the non-fork path
    only when +N was given.

    The unit differs by kernel: macOS counts PROCESSES of the real uid, so it
    runs `/bin/ps -A -o ruid=` with an empty environment and counts the lines
    equal to `uid` (sbx is not an MCP server, so subprocess.run is fine here);
    Linux counts TASKS (threads) of the real uid, so it is uid_task_count. A
    failure RAISES (OSError, ValueError or subprocess.SubprocessError); the
    caller turns it into exit 3."""
    want = str(int(uid))
    if sys.platform == "darwin":
        proc = subprocess.run(["/bin/ps", "-A", "-o", "ruid="], env={},
                              stdin=subprocess.DEVNULL, capture_output=True,
                              timeout=5)
        if proc.returncode != 0:
            raise OSError("/bin/ps exited %d" % proc.returncode)
        return sum(1 for line in proc.stdout.decode("ascii", "replace").split()
                   if line == want)
    return uid_task_count(uid)


def uid_task_count(uid, proc_root="/proc"):
    """Linux: the number of TASKS whose real uid is `uid` -- what the kernel
    charges RLIMIT_NPROC against at clone(), threads included. Counting
    processes instead under-counts a threaded uid (127 processes, 1054 tasks)
    and the resulting +N limit makes the sandbox engine's own clone fail
    EAGAIN. Scans <proc_root>/[0-9]*/status once per pid: the `Uid:` line's
    real-uid field selects, the `Threads:` line of the SAME read is the task
    count (1 when absent); a pid that vanished mid-scan is ignored."""
    want = str(int(uid))
    count = 0
    for name in os.listdir(proc_root):
        if not name.isdigit():
            continue
        try:
            with open(os.path.join(proc_root, name, "status")) as fh:
                mine, threads = False, 1
                for line in fh:
                    if line.startswith("Uid:"):
                        fields = line.split()
                        mine = len(fields) > 1 and fields[1] == want
                        if not mine:
                            break
                    elif line.startswith("Threads:"):
                        fields = line.split()
                        if len(fields) > 1 and fields[1].isdigit():
                            threads = max(1, int(fields[1]))
        except OSError:
            continue                      # the pid exited during the scan
        count += threads if mine else 0
    return count


def _resolve_limits(scope):
    """scope.limits plus the `--rlimit-nproc +N` pair resolved against the
    uid's CURRENT process count -> (limits, refusal). The count is taken only
    when +N was given; a count failure is a refusal (exit 3), never a skip."""
    limits = tuple(scope.limits or ())
    if scope.nproc_headroom is None:
        return limits, None
    try:
        count = uid_process_count(os.getuid())
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        return limits, ("cannot count the uid's processes for --rlimit-nproc "
                        "+%d (%s)" % (scope.nproc_headroom, type(exc).__name__))
    return limits + (("RLIMIT_NPROC", count + scope.nproc_headroom),), None


def _strict_rlimits(limits):
    """Apply each requested `(name, value)` limit with soft == hard -> None, or
    the refusal reason of the FIRST limit that cannot be applied.

    The STRICT counterpart of _apply_rlimits (P6), which swallows a refusal by
    design: a limit the CALLER asked for is a contract, so a value above the
    finite hard limit is refused (never clamped, KD-3) and a setrlimit the
    kernel rejects is refused too -- the caller then runs NOTHING (exit 3).
    soft == hard, so the target can neither raise the soft limit back up nor
    the hard one. A strict limit only ever NARROWS (R1, CWE-269): a value above
    the current finite SOFT limit is refused too -- setrlimit(value, value)
    would otherwise RAISE it (a non-zero --rlimit-core over an inherited soft 0
    turned kernel core dumps on, outside every write scope). Runs in the
    supervised child after fork, or in sbx itself right before the exec in
    non-fork mode, AFTER _apply_rlimits."""
    for name, value in limits or ():
        which = getattr(resource, name, None)
        if which is None:
            return "setrlimit %s refused (unsupported on this platform)" % name
        try:
            soft, hard = resource.getrlimit(which)
        except (ValueError, OSError) as exc:
            return "setrlimit %s refused (%s)" % (name, type(exc).__name__)
        if hard != resource.RLIM_INFINITY and value > hard:
            return ("setrlimit %s refused (%d is above the hard limit %d)"
                    % (name, value, hard))
        if soft != resource.RLIM_INFINITY and value > soft:
            return ("setrlimit %s refused (%d is above the current soft limit "
                    "%d; a strict limit never raises one)" % (name, value, soft))
        try:
            resource.setrlimit(which, (value, value))
        except (ValueError, OSError) as exc:
            return "setrlimit %s refused (%s)" % (name, type(exc).__name__)
    return None


def _prepare_exec(scope):
    """The exec triple `(engine_path, argv, env)` shared by the supervised
    fork path and the non-fork path (KD-5). Builds the argv with the
    platform's pure builder; a builder refusal raises ValueError (exit 3).

    `env` is None when the environment is inherited (scope.env is None): the
    argv is then exactly the builder's, and main()'s legacy branch keeps its
    literal execvp (sbx_seccomp's _Stubbed and sbx_gate's _main_in replace
    exactly that call). With `--clean-env` the ENGINE gets an EMPTY
    environment on both platforms (C-M7 = S-M1) -- nothing of sbx's own env
    reaches sandbox-exec or bwrap -- and the target's env travels in the argv:
    on darwin the target part after the profile becomes `/usr/bin/env -i
    K=V... <argv0> <args>` (keys sorted; the profile exec-allows
    /usr/bin/env, and validate_restricted refused an argv0 containing `=`),
    on linux the builder already emitted `--clearenv --setenv K V`."""
    builder, engine_path = _detect_engine()
    argv = builder(scope)
    if scope.env is None:
        return engine_path, argv, None
    if _platform_key(sys.platform) == "darwin":
        pairs = ["%s=%s" % (key, scope.env[key]) for key in sorted(scope.env)]
        argv = argv[:3] + ["/usr/bin/env", "-i"] + pairs + list(scope.argv)
    return engine_path, argv, {}


def _exec_clean(engine_path, argv):
    """The non-fork `--clean-env` exec: the engine by its ABSOLUTE path with
    an empty environment. Returns only on failure (exit 3, nothing ran)."""
    try:
        os.execve(engine_path, argv, {})
    except OSError as exc:
        sys.stderr.write(
            "sbx: error: failed to exec sandbox engine %r: %s\n" % (argv[0], exc))
        return 3
    return 0  # unreachable: execve either replaced the image or raised above


# The supervisor's signals: trapped in sbx (a flag the wait loop polls), reset
# to SIG_DFL in the child before anything else.
_TRAPPED_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
_STATUS_LINE_MAX = 512        # KD-1: one status line, '\n' included
_SETUP_MSG_MAX = 4096         # the child's setup-error message, read capped
_WAITID_POLL_S = 0.02         # linux: the waitid WNOHANG poll period
_KQ_POLL_S = 0.1              # darwin: the trapped-signal check period


def _write_status(fd, obj):
    """One status record on the --status-fd: compact JSON + '\\n', at most
    512 bytes, written with an os.write loop. No fd -> nothing. A write
    failure (EPIPE: the reader went away) is ignored -- the record is advisory
    and a failed write must never abandon a live process group.

    A long refusal reason is HALVED until the ENCODED line fits (M1): a
    character json-escapes to as many as six bytes (a control character is
    \\u00XX), so one cut of the reason's characters could still overflow, and
    the encoded bytes are never sliced -- that dropped the closing `}\\n` and
    the reader lost the terminal record. A record that cannot fit even
    without its reason is not written at all, never written broken."""
    if fd is None:
        return

    def _encode(record):
        return (json.dumps(record, separators=(",", ":")) + "\n").encode("ascii")
    data = _encode(obj)
    while len(data) > _STATUS_LINE_MAX and isinstance(obj.get("reason"), str) \
            and obj["reason"]:
        obj = dict(obj, reason=obj["reason"][:len(obj["reason"]) // 2])
        data = _encode(obj)
    if len(data) > _STATUS_LINE_MAX:
        return
    view = memoryview(data)
    while view:
        try:
            view = view[os.write(fd, view):]
        except OSError:
            return


def _exit_record(start, outcome, code, sig, reason=None):
    obj = {"sbx": 1, "event": "exit", "outcome": outcome, "code": code,
           "signal": sig,
           "durationMs": max(0, int((time.monotonic() - start) * 1000))}
    if reason is not None:
        obj["reason"] = reason
    return obj


def _refused(fd, start, reason):
    """A fail-closed refusal: one `sbx: error:` stderr line, one `exit`
    record with outcome `refused` (no `spawned` before it), exit 3."""
    sys.stderr.write("sbx: error: %s\n" % reason)
    _write_status(fd, _exit_record(start, "refused", 3, None, reason))
    return 3


def _wait_exit_unreaped(pid, deadline, kq=None, flag=None):
    """Wait until child `pid` EXITS without reaping it (KD-2) -> True, or
    False when `deadline` (time.monotonic) passes or `flag` (the supervisor's
    trapped-signal list) becomes non-empty first.

    Not reaping is the point: a zombie leader keeps its pid -- and so its
    process group id -- reserved, so _sweep can SIGKILL the group's
    background stragglers BEFORE the waitpid that frees the id (kill before
    reap). Neither branch reaps.

    The branch is selected by sys.platform, NEVER by hasattr(os, ...) on
    waitid: Python >= 3.13 exposes os.waitid on darwin too (M0:1).
      darwin  a kqueue EVFILT_PROC / NOTE_EXIT event, registered with
              nevents == 0 -- an already-exited (zombie) child then raises
              ESRCH, the ONE shape caught, which means exited-unreaped (with
              nevents >= 1 the kernel would answer an EV_ERROR event
              instead, M0:1) -- then polled at most 100 ms at a time so the
              flag is seen. `kq` is the caller's kqueue (None: one is made
              here and closed in the finally).
      linux   os.waitid(P_PID, pid, WEXITED | WNOWAIT | WNOHANG) every 20 ms.
    """
    if sys.platform == "darwin":
        assert hasattr(select, "kqueue"), "darwin without kqueue"
        own = kq is None
        if own:
            kq = select.kqueue()
        try:
            event = select.kevent(
                pid, filter=select.KQ_FILTER_PROC,
                flags=select.KQ_EV_ADD | select.KQ_EV_ONESHOT,
                fflags=select.KQ_NOTE_EXIT)
            try:
                kq.control([event], 0, 0)
            except OSError as exc:
                if exc.errno != errno.ESRCH:
                    raise
                return True               # already exited, still unreaped
            while True:
                if flag:
                    return False
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return False
                if kq.control(None, 1, min(remaining, _KQ_POLL_S)):
                    return True
        finally:
            if own:
                kq.close()
    while True:
        try:
            info = os.waitid(os.P_PID, pid,
                             os.WEXITED | os.WNOWAIT | os.WNOHANG)
        except ChildProcessError:
            return True
        if info is not None:
            return True
        if flag:
            return False
        if time.monotonic() >= deadline:
            return False
        time.sleep(_WAITID_POLL_S)


def _sweep(pid, kill_leader=False):
    """Kill the whole process group `pid` leads, THEN reap the leader ->
    its waitpid status. ESRCH (group gone) and EPERM (macOS's answer for a
    zombie-only group, M0:1) are ignored. `kill_leader` also SIGKILLs the
    leader by pid (linux: bwrap, whose --new-session put the target in a
    group of its own; its death tears the pid namespace down)."""
    try:
        os.killpg(pid, signal.SIGKILL)
    except OSError as exc:
        if exc.errno not in (errno.ESRCH, errno.EPERM):
            raise
    if kill_leader:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    return os.waitpid(pid, 0)[1]


def _supervised_child(scope, r, w, engine_path, argv, env, limits):
    """The forked child of _supervise. NEVER returns: it execs the engine or
    reports its setup failure on `w` and _exit(127)s."""
    try:
        # FIRST: the target must not inherit the supervisor's Python handlers
        for sig in _TRAPPED_SIGNALS:
            signal.signal(sig, signal.SIG_DFL)
        os.close(r)
        if scope.status_fd is not None:
            os.close(scope.status_fd)     # never inherited by the target (T8)
        os.setsid()                       # pid == pgid == sid: killpg reaches all
        _apply_rlimits()                  # P6: best-effort, the unrequested ones
        reason = _strict_rlimits(limits)
        if reason is None:
            try:
                os.execve(engine_path, argv,
                          os.environ if env is None else env)
            except OSError as exc:
                reason = "failed to exec sandbox engine %r: %s" % (argv[0], exc)
        os.write(w, reason.encode("utf-8", "replace")[:_SETUP_MSG_MAX])
    except BaseException as exc:          # noqa: BLE001 -- never return to the parent's code
        try:
            os.write(w, ("supervised child setup failed (%s)"
                         % type(exc).__name__).encode("ascii"))
        except BaseException:             # noqa: BLE001
            pass
    finally:
        os._exit(127)


def _read_setup(r):
    """The child's setup-error channel, read to EOF (capped): empty = the
    engine was exec'd (the CLOEXEC write end closed), else the reason."""
    data = b""
    while True:
        chunk = os.read(r, 4096)
        if not chunk:
            return data
        if len(data) < _SETUP_MSG_MAX:
            data += chunk


def _supervise(scope, engine_path, argv, env):
    """The supervised fork path (`--timeout`, KD-1/KD-2) -> sbx's exit code.

      1. a CLOEXEC setup-error pipe;
      2. the `--rlimit-nproc +N` pair resolved against the uid's count;
      3. SIGTERM/SIGINT/SIGHUP trapped BEFORE fork (R2:L3), so a signal that
         lands between the fork and the `spawned` record is never lost;
      4. fork; the child resets the handlers, closes the read end and the
         status fd, setsid()s, applies the rlimits (strict ones refused, not
         skipped) and execve()s the engine -- or reports why not on the pipe;
      5. a non-empty pipe -> reap, one `refused` exit record, no `spawned`,
         one stderr line, exit 3;
      6. `spawned` {pid, pgid} (pgid == pid: the child is a session leader);
      7. wait for the exit WITHOUT reaping, then kill the group, then reap
         (_wait_exit_unreaped + _sweep); the deadline or a trapped signal
         kills the group instead;
      8. the terminal `exit` record; the saved handlers restored.
    Exit codes: the target's code when it exited, 128 + N when it was killed
    by signal N (or sbx itself got N), 124 on the wall-clock timeout, 3 on a
    refusal."""
    start = time.monotonic()
    fd = scope.status_fd
    limits, reason = _resolve_limits(scope)
    if reason is not None:
        return _refused(fd, start, reason)
    trapped = []

    def _on_signal(signum, _frame):
        if not trapped:
            trapped.append(signum)

    saved = {}
    r = w = pid = None
    reaped = False
    try:
        r, w = os.pipe()
        for sig in _TRAPPED_SIGNALS:
            saved[sig] = signal.signal(sig, _on_signal)
        try:
            pid = os.fork()
        except OSError as exc:
            return _refused(fd, start, "cannot fork the supervised child (%s)"
                            % type(exc).__name__)
        if pid == 0:
            _supervised_child(scope, r, w, engine_path, argv, env, limits)
        os.close(w)
        w = None
        setup = _read_setup(r)
        os.close(r)
        r = None
        if setup:
            os.waitpid(pid, 0)
            reaped = True
            return _refused(fd, start, setup.decode("utf-8", "replace")
                            .replace("\n", " ").strip())
        _write_status(fd, {"sbx": 1, "event": "spawned", "pid": pid,
                           "pgid": pid})
        deadline = time.monotonic() + scope.timeout
        linux = _platform_key(sys.platform) == "linux"
        if _wait_exit_unreaped(pid, deadline, flag=trapped):
            status = _sweep(pid)
            reaped = True
            if os.WIFSIGNALED(status):
                sig = os.WTERMSIG(status)
                _write_status(fd, _exit_record(start, "signaled", None, sig))
                return 128 + sig
            code = os.WEXITSTATUS(status)  # no WUNTRACED: exited or signaled
            _write_status(fd, _exit_record(start, "exited", code, None))
            return code
        _sweep(pid, kill_leader=linux)
        reaped = True
        if trapped:
            sig = trapped[0]
            sys.stderr.write("sbx: signal %d received; process group killed\n"
                             % sig)
            _write_status(fd, _exit_record(start, "signaled", None, sig))
            return 128 + sig
        sys.stderr.write("sbx: timeout: wall-clock limit of %gs reached; "
                         "process group killed\n" % scope.timeout)
        _write_status(fd, _exit_record(start, "timeout", None,
                                       int(signal.SIGKILL)))
        return 124
    finally:
        for end in (r, w):
            if end is not None:
                os.close(end)
        if pid and not reaped:            # an unexpected error: never orphan
            try:
                _sweep(pid, kill_leader=True)
            except OSError:
                pass
        for sig, old in saved.items():
            signal.signal(sig, signal.SIG_DFL if old is None else old)


def _restricted_scope(args, target, cwd):
    """Build the Scope for an invocation that carries ANY restricted-mode flag
    (ADR 0031). Order: the pure value parsers, the cross-flag validator, then
    -- only under --restrict-reads -- the I/O resolvers (resolve_reads, plus
    linux_base_reads on Linux) and the metadata ancestors. Every refusal exits
    here (2 usage, 3 containment), before anything is built or run.

    Restricted mode passes carveouts=(): the ~/.claude carve-outs are READ
    grants, and restricted reads are an allowlist (FR-1)."""
    writes = compute_writes(args.write, args.ro, cwd)   # KD-7 + R14 + --ro (R21)
    env = parse_env(args.env, args.clean_env)
    limits, nproc_headroom = parse_limits(args)
    timeout = parse_timeout(args.timeout)
    status_fd = parse_status_fd(args.status_fd, timeout)
    validate_restricted(args, target[0], cwd, writes)
    # Egress (exit 2 usage / exit 3 platform), then the socket itself (exit 3).
    egress_port, egress_socket = validate_egress(args,
                                                 _platform_key(sys.platform))
    if egress_socket is not None:
        reason = egress_socket_refusal(egress_socket)
        if reason is not None:
            _containment_refusal("--egress-socket: %s" % (reason,))

    read_rules, exec_rules, meta, base = (), (), (), ()
    if args.restrict_reads:
        read_rules, exec_rules = resolve_reads(args.read, args.exec, target[0])
        meta = metadata_ancestors(
            [rule[0] for rule in read_rules] + list(writes)
            + [rule[0] for rule in exec_rules] + [cwd])
        if _platform_key(sys.platform) == "linux":
            base = linux_base_reads()
    # The forwarder's interpreter must already be visible inside the root;
    # refuse here (exit 3) rather than let the bwrap builder raise later.
    fwd_python = None
    if egress_socket is not None:
        fwd_python = egress_python(base, read_rules)
        if fwd_python is None:
            _containment_refusal(
                "--egress-socket: the forwarder interpreter %s (or its stdlib "
                "prefix) is not visible inside the restricted root; grant it "
                "with --read" % (os.path.realpath(sys.executable or ""),))
    return Scope(
        writes=writes,
        net=args.net,
        ro=args.ro,
        argv=target,
        secret_paths=secret_paths(cwd),
        carveouts=() if args.restrict_reads else carveout_paths(),
        shadow_write_denies=shadow_write_denies(),
        seccomp=args.seccomp,
        cwd=cwd,
        restrict_reads=args.restrict_reads,
        read_rules=read_rules,
        meta_literals=meta,
        exec_rules=exec_rules,
        linux_base=base,
        env=env,
        timeout=timeout,
        status_fd=status_fd,
        limits=limits,
        nproc_headroom=nproc_headroom,
        egress_port=egress_port,
        egress_socket=egress_socket,
        egress_python=fwd_python,
    )


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    left, target = _split_argv(argv)
    if target is None:
        _usage_error("missing '--' separator before the target command")
    if not target:
        _usage_error("no command given after '--'")

    args = _build_parser().parse_args(left)

    # P1: the cwd (and its realpath) is floored ONCE, before any scope is
    # computed from it, in both modes -- exit 3 and nothing resolved or run.
    cwd = floor_cwd(os.getcwd())
    # Restricted mode (ADR 0031) only when a new flag asks for it; a legacy
    # invocation keeps the exact call sequence below (sbx_gate row Q).
    restricted = _restricted_flags_given(args)
    if restricted:
        scope = _restricted_scope(args, target, cwd)
    else:
        scope = Scope(
            writes=compute_writes(args.write, args.ro, cwd),   # KD-7 + R14 + --ro (R21)
            net=args.net,
            ro=args.ro,
            argv=target,
            secret_paths=secret_paths(cwd),   # M-A / sec-MED-2 ancestor-.git deny set
            carveouts=carveout_paths(),       # read-ONLY holes in the ~/.claude deny
            # write-ONLY deny on the OTHER spelling of ~/.claude's symlinked-out trees
            shadow_write_denies=shadow_write_denies(),
            seccomp=args.seccomp,             # OFF unless --seccomp (R-0003)
            cwd=cwd,                          # re-bound if under a socket dir (R-0061)
        )

    # Round-3 R1: a carve-out or shadow target that is, contains or lies under
    # a socket directory is refused (exit 3) in both modes, --dry-run included,
    # before anything is planned or run -- never dropped.
    reason = socket_bind_refusal(scope.carveouts, scope.shadow_write_denies)
    if reason is not None:
        sys.stderr.write("sbx: error: refusing to run: %s\n" % reason)
        sys.exit(3)

    # --dry-run previews the resolved plan and runs NOTHING. Engine resolution
    # here is best-effort DISPLAY only and NEVER fail-closes -- a preview must
    # work on any host, even one without a sandbox binary installed. (A key of
    # None short-circuits before ENGINE_BINARY is indexed, so this never raises.)
    if args.dry_run:
        key = _platform_key(sys.platform)
        if BACKENDS.get(key) is not None:
            scope.engine = shutil.which(ENGINE_BINARY[key])
        print(_format_plan(scope))
        return 0

    # --status-fd: the supervisor writes its records there, so the fd must be
    # open NOW -- a usage error (exit 2) before anything is resolved or run.
    if scope.status_fd is not None:
        try:
            os.fstat(scope.status_fd)
        except OSError:
            _usage_error("--status-fd %d: not an open file descriptor"
                         % (scope.status_fd,))

    # Real path: FAIL-CLOSED platform + sandbox-binary detection FIRST (task-002,
    # KD-3, NFR-1, R20). On an unknown platform or a missing sandbox binary this
    # exits non-zero WITHOUT ever constructing or running a target -- there is no
    # unsandboxed fallback, EVER.
    builder, engine = _detect_engine()
    scope.engine = engine

    # --seccomp: build the BPF program and park it on an inheritable fd NOW, so
    # the pure builder below only has to print the fd number. Refuses (exit 3,
    # nothing run) off Linux x86_64 -- never the same command unfiltered.
    if scope.seccomp:
        scope.seccomp_fd = _seccomp_fd()

    # bwrap file masks: one empty fd per FILE secret (Seatbelt needs none).
    if builder is _bwrap_argv:
        scope.file_mask_fds = _file_mask_fds(scope.secret_paths)

    # Build the OS-sandbox invocation from the fully-validated Scope via the
    # platform's pure builder (task-004 Seatbelt / task-005 bwrap). argv is a
    # LIST: the target cmd/args are argv ELEMENTS, never a shell string, so they
    # can never inject into the profile (NFR-4). A builder refusal (ValueError) is
    # one stderr line and exit 3 -- nothing is run. Restricted mode builds the
    # whole exec triple (engine path, argv, engine env) through _prepare_exec,
    # which also lays the darwin `/usr/bin/env -i` clean-env trampoline (KD-5).
    if restricted:
        try:
            engine_path, argv, env = _prepare_exec(scope)
        except ValueError as exc:
            return _refused(scope.status_fd, time.monotonic(), str(exc))
    else:
        try:
            argv = builder(scope)
        except ValueError as exc:
            sys.stderr.write("sbx: error: %s\n" % exc)
            return 3

    # Create ONLY the default scratch scope, and only when it is actually in the
    # writable set (no flags -> [<cwd>/.claude/tmp]; --ro -> [] so nothing is
    # made; an explicit --write DIR target is the user's responsibility and is
    # assumed to exist). This is the deferred makedirs the pure layer refused to
    # do (M3): a real side effect, behind __main__, and NEVER a shell mkdir.
    scratch = scratch_scope(cwd)
    if scratch in scope.writes:
        os.makedirs(scratch, exist_ok=True)

    # --timeout: the supervised fork path (KD-1/KD-2). The child applies the
    # rlimits itself, after fork and before its exec of the engine.
    if scope.timeout is not None:
        return _supervise(scope, engine_path, argv, env)

    # *** ORDERING IS LOAD-BEARING (KD-4): setrlimit BEFORE os.execvp. ***
    # os.execvp replaces this process image but keeps the SAME PID, and resource
    # limits SURVIVE exec, so the sandboxed target inherits every limit set here.
    # After execvp this code never runs -- so the limits MUST be set first.
    _apply_rlimits()

    # Restricted, non-fork: the STRICT limits on top (soft == hard; a refusal is
    # exit 3 and nothing runs), then the clean-env exec with an EMPTY engine
    # environment when --clean-env asked for one.
    if restricted:
        limits, reason = _resolve_limits(scope)
        if reason is None:
            reason = _strict_rlimits(limits)
        if reason is not None:
            sys.stderr.write("sbx: error: %s\n" % reason)
            return 3
        if env is not None:
            return _exec_clean(engine_path, argv)

    # The FIRST and ONLY point at which sbx runs a child. os.execvp REPLACES this
    # process with the sandbox engine -- no fork/waitpid wrapper -- so the
    # target's exit status passes straight through as sbx's own (NFR-6). execvp
    # returns ONLY on failure; if it does, NOTHING ran (this is not an
    # unsandboxed run), so we fail-closed with a one-line reason (NFR-1 spirit).
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        sys.stderr.write(
            "sbx: error: failed to exec sandbox engine %r: %s\n" % (argv[0], exc))
        return 3
    return 0  # unreachable: execvp either replaced the image or raised above


if __name__ == "__main__":
    sys.exit(main())
