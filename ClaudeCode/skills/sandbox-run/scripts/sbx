#!/usr/bin/env python3
"""
sbx -- run a command inside an OS sandbox (default-deny writes, no network).
Usage: sbx [--write DIR]... [--net] [--ro] [--seccomp] [restricted-mode flags]
           -- <cmd> [args...]

Everything after the FIRST bare `--` is the target command. It is handed to
os.execvp as argv LIST ELEMENTS, never through a shell, so it can never inject
into the sandbox profile. `--write DIR` (repeatable) adds a writable scope
(`--write .` opts into the repo), `--net` allows the network, `--ro` denies ALL
writes including the default scratch scope, `--seccomp` adds the Linux x86_64
syscall allowlist (R-0003; refused anywhere else), and `--dry-run` prints the
resolved plan and runs NOTHING.

This feature is a SECURITY BOUNDARY, so the helper is built pure-pieces-first /
execvp-last. This file is the SKELETON (task-001): the argument model, the manual
`--` split, the Scope object, and `--dry-run`. The real containment lands in later
tasks, each layered behind the same __main__ guard:
  - task-002: fail-closed platform + sandbox-binary detection (BACKENDS registry);
  - task-003: the pure injection/secret/realpath guard layer + secret_paths()
    (its read-only counterpart carveout_paths(), and the write-only
    shadow_write_denies() that closes the name divergence the carve-out opens);
  - task-004/005: the Seatbelt (SBPL) and bwrap pure argv builders;
  - task-006: the single resource.setrlimit + os.execvp site (the ONLY child run).

Every side effect (argparse dispatch, scratch makedirs, setrlimit, execvp) MUST
live behind `if __name__ == "__main__":` -- via a main() called only from it. The
module TOP LEVEL stays import-side-effect-free so the offline suite can import the
module and call the pure pieces WITHOUT triggering any exec/setrlimit/makedirs (M3).

Python 3, standard library only.
"""
from __future__ import annotations

import argparse
import errno
import grp
import json
import os
import pwd
import re
import resource
import select
import shutil
import signal
import stat
import struct
import subprocess
import sys
import time
from dataclasses import dataclass

USAGE = ("Usage: sbx [--write DIR]... [--net] [--ro] [--seccomp] "
         "[--restrict-reads [--read PATH]... [--exec PATH]...] "
         "[--clean-env [--env KEY=VALUE]...] [--timeout S [--status-fd FD]] "
         "[--rlimit-{as,cpu,nproc,fsize,nofile,core} N] "
         "[--egress-port N | --egress-socket PATH] -- <cmd> [args...]")

# R-0061: the standard directories of pathname AF_UNIX sockets (docker, the D-Bus
# system and session buses, gpg-agent, ssh-agent, tmux, X11). A socket is a
# filesystem object, so neither --unshare-net nor a read-only bind stops connect()
# on it; without --net bwrap hides these behind an empty tmpfs (Linux only --
# Seatbelt's (deny network*) already denies unix-socket connect, measured).
# /var/run is a symlink to /run on every current distribution; /var/snap holds snap
# daemons' sockets (lxd: root-equivalent for the lxd group). Snap binaries live
# under /snap, which stays visible.
SOCKET_DIRS = ("/run", "/tmp", "/var/snap")
# The directories a restricted `--read` / `--exec` may not RESOLVE into (P2,
# CWE-41): SOCKET_DIRS plus /var/run. /var/run is a symlink to /run, so bwrap's
# tmpfs over /run already hides it and it is NOT mounted again (the mount list
# above stays the legacy argv) -- it is listed here because a spelling check
# alone let `--read /var/run/docker.sock` bind the host socket past the tmpfs.
# socket_read_refusal() checks every hop and the realpath against this list.
SOCKET_REFUSED_DIRS = SOCKET_DIRS + ("/var/run",)
# The socket directories a write scope, a ~/.claude carve-out or a shadow
# re-bind target may not lie UNDER either (round-3 R1/R2): a bind below /run is
# /run/user/<uid> -- D-Bus, ssh-agent, gpg-agent. /tmp is left out on purpose,
# like a cwd under it: a scope or a repo checkout under /tmp is common, and the
# sockets a bind there re-exposes are only those inside the bound subtree.
SOCKET_UNDER_REFUSED_DIRS = ("/run", "/var/run", "/var/snap")

# Egress (restricted mode): the ONE network endpoint a run may reach, the
# caller's allowlisting CONNECT proxy. On bwrap the caller's unix socket is
# ro-bound at this FIXED path in the empty root -- outside every
# SOCKET_DIRS entry, so the socket tmpfs logic is untouched: one explicit
# bind, not a hole (M0 on para: connect() works through the ro bind, and
# the target cannot unlink the mountpoint, EBUSY). The forwarder listens on
# 127.0.0.1:EGRESS_FORWARD_PORT inside the private netns (bwrap brings lo
# up: M0) -- a fixed port, the proxy URL the caller hands the target.
EGRESS_SOCKET_DEST = "/.sbx-egress.sock"
EGRESS_FORWARD_PORT = 3128
_EGRESS_PORT_RE = r"[0-9]{1,5}"

# The bwrap forwarder: run by EGRESS python (sbx's own interpreter, which
# must already be visible in the restricted root) as `-I -S -B -c SRC <port>
# <socket> -- <target...>`. It binds 127.0.0.1:<port> FIRST (no race with
# the target), forks a relay child that keeps the parent's process group,
# and the parent execs the target in place -- so the target keeps the pid
# bwrap waits on, its exit status is the run's, and the relay dies with the
# pid namespace when the target exits (M0: 0.32 s, rc passed through, no
# leftover). The relay also exits when its parent changes (the same rule
# without a pid namespace), redirects its stdio to /dev/null so it never
# holds the run's output pipes, caps itself at 32 connections (the runner
# proxy's own cap) and drops -- never dies on -- one it cannot start a
# thread or fd for, and splices
# bytes only -- the CONNECT is the caller's proxy's business. Stdlib, no
# exec of its own, Python 3.6+.
EGRESS_FORWARDER = r'''
import os, select, socket, sys, threading, time
if len(sys.argv) < 5 or sys.argv[3] != "--":
    sys.stderr.write("sbx-egress: usage: <port> <socket> -- <cmd>\n")
    sys.exit(127)
port, path, target = int(sys.argv[1]), sys.argv[2], sys.argv[4:]
ls = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
ls.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
ls.bind(("127.0.0.1", port))
ls.listen(16)
parent = os.getpid()
if os.fork() == 0:
    try:
        null = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(null, fd)
        slots = threading.BoundedSemaphore(32)

        def splice(c, u):
            try:
                c.settimeout(None)
                u.connect(path)
                open_ = {c: u, u: c}
                while open_:
                    if os.getppid() != parent:
                        return
                    ready = select.select(list(open_), [], [], 1.0)[0]
                    for s in ready:
                        data = s.recv(65536)
                        if data:
                            open_[s].sendall(data)
                            continue
                        try:
                            open_[s].shutdown(socket.SHUT_WR)
                        except OSError:
                            pass
                        del open_[s]
            except OSError:
                pass
            finally:
                c.close()
                u.close()
                slots.release()

        ls.settimeout(1.0)
        while os.getppid() == parent:
            try:
                c, _addr = ls.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            if not slots.acquire(blocking=False):
                c.close()
                continue
            u = None
            try:
                u = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                threading.Thread(target=splice, args=(c, u),
                                 daemon=True).start()
            except (RuntimeError, OSError):
                # no thread or fd left (RLIMIT_NPROC / NOFILE): drop this
                # connection, never the relay
                c.close()
                if u is not None:
                    u.close()
                slots.release()
                time.sleep(0.05)
    finally:
        os._exit(0)
ls.close()
try:
    os.execvp(target[0], target)
except OSError as exc:
    sys.stderr.write("sbx-egress: cannot exec %r: %s\n" % (target[0], exc.strerror))
    os._exit(127)
'''


@dataclass
class Scope:
    """The resolved sandbox request -- pure data. Later tasks turn a Scope into a
    backend argv (task-004/005) and exec it (task-006); nothing here runs a child.

    Fields:
      writes       resolved writable scopes (absolute paths), computed by
                   compute_writes (task-003): each --write DIR canonicalize()'d
                   (KD-7 + R14 injection reject), or the default
                   <cwd>/.claude/tmp scratch scope, or an empty set under --ro.
      net          allow network access (denied by default).
      ro           deny all writes (including the scratch default).
      argv         the target command after `--`, kept verbatim for os.execvp.
      secret_paths the read+write deny set produced by secret_paths(cwd)
                   (task-003, M-A / sec-MED-2 ancestor-.git walk), as
                   `(path, is_dir)` PAIRS. The is_dir bit is resolved THERE, in
                   the one function that already performs the existence I/O, so
                   _bwrap_argv can pick the correct mask primitive (tmpfs for a
                   directory, ro-bind-data for a file) while staying PURE, and both
                   builders use it to emit the FILE masks after the carve-outs.
      carveouts    the read-ONLY carve-out set produced by carveout_paths(): the
                   named subtrees of a denied secret that must stay READABLE
                   (~/.claude/skills, ~/.claude/scripts -- this repo's own
                   tooling). They are emitted AFTER the secret masks so they win
                   back READ, and they never gain WRITE: ~/.claude as a whole
                   stays write-denied, which is the feature's whole point.
      shadow_write_denies
                   the WRITE-only deny set produced by shadow_write_denies():
                   the realpath TARGETS of the symlinks that lead out of
                   ~/.claude. The ~/.claude deny is spelled `~/.claude`, so a
                   command that reaches the SAME inode through the other
                   spelling (a repo path) was never covered by it -- measured
                   live, see the function. These are emitted after EVERY
                   write-allow so they win, and they are WRITE-ONLY: adding a
                   read-deny would re-close exactly what `carveouts` opened.
      engine       the resolved sandbox-engine binary path -- filled by the
                   fail-closed detection in task-002 (BACKENDS + shutil.which);
                   None until a backend is resolved.
      seccomp      OFF-by-default Linux syscall filter, set only by `--seccomp`
                   (R-0003) and consumed by the `if scope.seccomp:` branch inside
                   _bwrap_argv (locked decision 8 / NFR-9) -- an `if`, not a new
                   code path or a class hierarchy.
      seccomp_fd   the inheritable fd holding the compiled BPF program, resolved
                   by _seccomp_fd() in main() -- the ONE place that does the
                   memfd I/O -- so _bwrap_argv only prints the NUMBER and stays
                   pure. None until resolved; the flag with no fd refuses.
      file_mask_fds
                   one fd on /dev/null per FILE secret, in order, opened by
                   main() for the bwrap `--ro-bind-data` masks (Linux only).
      cwd          the working directory sbx was started in; bwrap re-binds it
                   read-only when it lies under /tmp, which the socket mask would
                   otherwise bury, and refuses it under /run or /var/snap (Linux
                   only).

    Restricted mode (ADR 0031) -- every field below defaults to the legacy
    behaviour, so a Scope built without them yields byte-identical builder
    output (sbx_restrict:D4):
      restrict_reads
                   OFF-by-default read restriction, set only by
                   `--restrict-reads`: reads become an allowlist instead of
                   `(allow file-read* (subpath "/"))`.
      read_rules   the resolved read allowlist as `(spelling, kind, link_value)`
                   triples, kind in {"symlink", "dir", "file"}; the spelling is
                   kept (normpath only, never realpath'd) and resolved by the
                   one resolver called from main().
      meta_literals
                   the ancestor directories that get a LITERAL
                   file-read-metadata allow (never a global metadata rule).
      exec_rules   the process-exec allowlist as `(spelling, is_dir)` pairs.
      linux_base   the bwrap base filesystem of restricted mode, in argv order:
                   `("ro-bind", path)` or `("symlink", value, path)`.
      env          the child environment: None = inherit (legacy); a dict =
                   `--clean-env` plus the validated `--env KEY=VALUE` pairs.
                   Values are NEVER printed, only keys.
      timeout      supervised-mode wall clock in seconds (`--timeout`); None =
                   unsupervised execvp (legacy).
      status_fd    the inheritable fd (>= 3) the supervisor writes its status
                   record to (`--status-fd`, requires `--timeout`).
      limits       the strict requested rlimits as `(name, value)` pairs, e.g.
                   `("RLIMIT_AS", int)`; a refused setrlimit fails closed.
      nproc_headroom
                   the `--rlimit-nproc +N` form: N processes above the uid's
                   current count, resolved in main(); None when not used.

    Egress (restricted mode only; the allowlisting CONNECT proxy is the
    CALLER's -- mcp-sandbox -- and these fields name the ONE endpoint of it
    the sandbox may reach). Both None = no network at all, the profile and
    argv byte-identical to a run without them:
      egress_port  Seatbelt: the 127.0.0.1 port (`--egress-port N`); the
                   profile keeps (deny network*) and adds ONE
                   (allow network-outbound (remote tcp "localhost:N")).
      egress_socket
                   bwrap: the caller's own unix socket (`--egress-socket
                   PATH`), ro-bound at EGRESS_SOCKET_DEST; the private netns
                   stays (--unshare-net) and the target is wrapped in the
                   stdlib forwarder EGRESS_FORWARDER (127.0.0.1:
                   EGRESS_FORWARD_PORT inside -> the socket).
      egress_python
                   bwrap: the interpreter that runs the forwarder -- sbx's
                   own realpath, which must already be visible inside the
                   restricted root (resolved in main()).
    """
    writes: list
    net: bool
    ro: bool
    argv: list
    secret_paths: tuple = None
    carveouts: tuple = None
    shadow_write_denies: tuple = None
    engine: str = None
    seccomp: bool = False
    seccomp_fd: int = None
    file_mask_fds: tuple = None
    cwd: str = None
    restrict_reads: bool = False
    read_rules: tuple = ()
    meta_literals: tuple = ()
    exec_rules: tuple = ()
    linux_base: tuple = ()
    env: dict = None
    timeout: float = None
    status_fd: int = None
    limits: tuple = ()
    nproc_headroom: int = None
    egress_port: int = None
    egress_socket: str = None
    egress_python: str = None


# ---------------------------------------------------------------------------
# Backend registry + fail-closed platform/binary detection (task-002).
#
# This is a SECURITY BOUNDARY (KD-3, NFR-1, NFR-2, R20): sbx selects an OS
# sandbox backend from a registry keyed on a sys.platform PREFIX, with a
# FAIL-CLOSED default. An unknown platform -- or a supported platform whose
# sandbox binary is absent from PATH -- makes sbx write a one-line reason to
# stderr and exit non-zero WITHOUT ever constructing or running a target. There
# is NO unsandboxed fallback, EVER.
#
# The registry and the two builder stubs are PURE module-level definitions (no
# I/O at import, M3). Detection itself (_detect_engine) performs a shutil.which
# read only when CALLED from main() behind the __main__ guard -- never at import.

# Restricted Seatbelt: the depth cap's level count and the regex metacharacters
# a write-scope spelling may still carry after the _INJECT_CHARS floor (quotes,
# parens, backslash and newline never get this far; "(", ")" and "\" are listed
# anyway so the escape does not depend on that floor).
_DEPTH_CAP_LEVELS = 100
_SBPL_REGEX_META = frozenset("\\.^$*+?{}[]|()")


def _depth_cap_regex(scope):
    """The write scope's canonical spelling as an SBPL regex prefix: every regex
    metacharacter (\\ . ^ $ * + ? { } [ ] | ( )) backslash-escaped, so the
    depth cap anchors on exactly this directory. Pure."""
    return "".join("\\" + ch if ch in _SBPL_REGEX_META else ch for ch in scope)


def _sbpl_path(path):
    """The ONE point every path interpolated into an SBPL string literal passes
    (P1, CWE-74) -> `path` unchanged, or ValueError (exit 3, nothing run).

    An SBPL string is delimited by `"` and escapes with `\\`, so a path carrying
    either -- or a control character -- could close the literal and append a
    rule of its own (`a"))(allow file-write* (regex #"^"))...` = write anywhere).
    The flag values are floored upstream (canonicalize, canonicalize_read, the
    cwd floor in main), but the deny set, the scratch scope and the metadata
    ancestors are DERIVED paths ($HOME, the cwd's ancestors, symlink targets),
    so the builder refuses rather than trusting every producer. Refusal, never
    escaping: a refused run is visible, a mis-escaped rule is not. Pure."""
    if not isinstance(path, str) or any(ch in _INJECT_CHARS for ch in path):
        raise ValueError(
            "refusing to build the Seatbelt profile: the path %r contains an "
            "SBPL string metacharacter (one of \" ' ( ) \\ or a control "
            "character)" % (path,))
    return path


def _seatbelt_restricted_head(scope):
    """The allowlist head of the restricted Seatbelt profile (ADR 0031): every
    rule before the write block, in the order _seatbelt_argv documents. Pure.

    A request with nothing to filter exec on (a bare command name, no --exec,
    an inherited env) is refused with ValueError (exit 3): an unfiltered
    (allow process-exec) is exactly what restricted mode removes, and an
    empty filter list is not valid SBPL."""
    argv0 = scope.argv[0] if scope.argv else None
    first = [p for p, is_dir in scope.exec_rules if p == argv0 and not is_dir]
    files = [p for p, is_dir in scope.exec_rules
             if not is_dir and p != argv0]
    dirs = [p for p, is_dir in scope.exec_rules if is_dir]
    exec_filters = ['(literal "%s")' % _sbpl_path(p) for p in first]
    # the KD-5 trampoline: a clean env is applied by `/usr/bin/env -i`
    if scope.env is not None and "/usr/bin/env" not in first + files:
        exec_filters.append('(literal "/usr/bin/env")')
    exec_filters += ['(literal "%s")' % _sbpl_path(p) for p in files]
    exec_filters += ['(subpath "%s")' % _sbpl_path(p) for p in dirs]
    if not exec_filters:
        raise ValueError(
            "--restrict-reads: no process-exec filter (a bare command name, no "
            "--exec, an inherited env); refusing an unfiltered exec allow")
    lines = [
        "(version 1)",
        "(deny default)",
        # exec is FILTERED; Seatbelt matches the REALPATH (M0:3)
        "(allow process-exec %s)" % " ".join(exec_filters),
        "(allow process-fork)",
        # same-sandbox, not self: `kill $!` of a background job (M0:2)
        "(allow signal (target same-sandbox))",
        # node's V8 aborts without it (M0:6)
        "(allow sysctl-read)",
        # readdir of "/" only -- never a subpath "/" read
        '(allow file-read-data (literal "/"))',
    ]
    # path lookup stats every component: a LITERAL per ancestor, never a global
    # metadata rule (the filesystem's shape would become an oracle)
    if scope.meta_literals:
        lines.append("(allow file-read-metadata %s)" % " ".join(
            '(literal "%s")' % _sbpl_path(p) for p in scope.meta_literals))
    # a bare-name PATH lookup stats <dir>/<name>, and an exec allow is not a
    # metadata allow -- so the exec dirs get metadata ONLY when the target env
    # can carry PATH (M0:4)
    if dirs and (scope.env is None or "PATH" in scope.env):
        lines.append("(allow file-read-metadata %s)" % " ".join(
            '(subpath "%s")' % _sbpl_path(p) for p in dirs))
    # the read spellings, never resolved (KD-14): a symlink or a file is a
    # LITERAL (a symlinked parent dir of an exec hop chain is READ here, never
    # exec), a directory a subpath
    literals = [p for p, kind, _value in scope.read_rules if kind != "dir"]
    subpaths = [p for p, kind, _value in scope.read_rules if kind == "dir"]
    if literals:
        lines.append("(allow file-read* %s)" % " ".join(
            '(literal "%s")' % _sbpl_path(p) for p in literals))
    if subpaths:
        lines.append("(allow file-read* %s)" % " ".join(
            '(subpath "%s")' % _sbpl_path(p) for p in subpaths))
    return lines


def _seatbelt_argv(scope):
    """Pure macOS Seatbelt builder (task-004): a Scope -> ["sandbox-exec", "-p",
    <profile>, *scope.argv] with <profile> an INLINE SBPL string (no temp .sb file).

    The rule order is LAST-MATCH-WINS and it is LOAD-BEARING (SBPL evaluation order
    is UNVERIFIED in-repo -- see the §2 constraint; probe d is the live gate): the
    secret denies MUST be emitted AFTER the permissive read-allow or they never take
    effect. Order:
      (version 1) / (deny default) / allow the minimal ops a CLI needs (exec, fork,
      self-signal, sysctl-read) / (allow file-read* (subpath "/")) permissive reads /
      per writable scope (allow file-write* (subpath "<canonical>")) UNLESS scope.ro
      (R21: then none) / (allow file-write* (literal "/dev/null")) ALWAYS, --ro
      included -- the sink stdin=DEVNULL opens O_RDWR; bwrap's fresh /dev keeps it
      writable under --ro too, and no later deny covers it / so they win, per
      DIRECTORY secret_paths entry BOTH
      (deny file-read* ...) and (deny file-write* ...) (R16/R17/R22/R22b) / per
      scope.carveouts entry (allow file-read* (subpath "<p>")) -- read ONLY, so
      last-match-wins hands the READ back for that subtree while the secret's WRITE
      deny above it still stands / per FILE secret_paths entry (the .git/config
      masks) the same read+write deny pair, AFTER the carve-outs so a .git/config
      inside a carve-out subtree keeps its deny (ADR 0007) / LAST of the file
      rules, per scope.shadow_write_denies entry (deny file-write* (subpath "<realpath>")) --
      write ONLY, closing the name divergence / (allow network*) if scope.net, else
      (deny network*) (R18).

    The carve-out lines MUST come after the secret denies for the same reason the
    denies must come after the permissive read-allow: last match wins. Emitting
    them earlier would make them dead rules. They deliberately carry NO
    file-write* allow -- ~/.claude must stay write-denied (a sandboxed command
    that could write it would be rewriting its own gate).

    The shadow write-denies come LAST of all the file rules, which is a stronger
    placement than they strictly need (anywhere after the write-allow block would
    do). Last is deliberate: the FINAL word on file writes is a DENY, so no allow
    added to this builder later can silently undo them. They are WRITE-only on
    purpose -- a read-deny on the repo spelling of ~/.claude/skills/p would re-hide
    exactly the plugin tree the carve-out above exists to open, and would hide the
    repo itself.

    Network is emitted EXPLICITLY in both directions. The profile opens with
    (deny default), so OMITTING (deny network*) under --net does NOT grant the
    network -- it leaves the default-deny standing, which made --net inert on macOS
    (measured). (allow network*) is the rule that actually grants it. Fail-closed is
    unchanged: without --net the (deny network*) line is emitted as before, on top of
    a default that already denies.

    Pure: no I/O. Every embedded path passes _sbpl_path, the ONE refusal point
    for a quote, paren, backslash or control character (ValueError, exit 3) --
    the flag values were floored upstream too, but the derived paths (the deny
    set, the scratch scope under the cwd, the ancestors) were not (P1). Never
    escape instead of refusing. The pre-resolved deny set (as (path, is_dir) pairs;
    this builder uses the bit only to ORDER a file mask after the carve-outs) and
    carve-out set are read
    off scope.secret_paths / scope.carveouts, both resolved ONCE in main(), keeping
    this builder side-effect-free.

    Restricted mode (scope.restrict_reads, ADR 0031) swaps the permissive head
    and the write block for an allowlist, keeping every DENY after every ALLOW:
      (version 1) / (deny default) / ONE filtered (allow process-exec ...) -- the
      argv0 spelling literal, (literal "/usr/bin/env") when the env is clean (the
      KD-5 trampoline), each --exec FILE literal, each --exec DIR subpath; the
      filter matches REALPATHS (M0:3), so the argv0 spelling is inert and the
      CALLER passes every realpath as --exec; sbx never resolves one (KD-14) /
      (allow process-fork) / (allow signal (target same-sandbox)) -- (target
      self) breaks `kill $!` (M0:2) / (allow sysctl-read) -- V8 aborts without it
      (M0:6) / (allow file-read-data (literal "/")) / ONE metadata rule with a
      LITERAL per ancestor (never a global metadata rule) / the exec DIRS'
      metadata as subpaths ONLY when the target env can carry PATH (a bare-name
      lookup stats <dir>/<name>; an exec allow is not a metadata allow, M0:4) /
      ONE file-read* rule of the symlink and file spellings as LITERALS (a
      symlinked parent dir is a READ literal, never an exec one) / ONE
      file-read* rule of the dir spellings as subpaths / UNLESS --ro: ONE read
      rule over the write scopes, the write-allow loop, ONE (deny
      file-write-acl ...) over the same scopes (never file-write-flags: it
      breaks copy2's chflags, M0:8) and per scope the 100-level depth cap / its
      OWN (allow file-read* file-write* (literal "/dev/null")) (M0:5) / the
      secret denies as above, with NO carve-outs (a carve-out is a read grant).
    """
    restricted = scope.restrict_reads
    if restricted:
        lines = _seatbelt_restricted_head(scope)
    else:
        lines = [
            "(version 1)",
            "(deny default)",
            # the minimal ops a normal program needs to start and run
            "(allow process-exec)",
            "(allow process-fork)",
            "(allow signal (target self))",
            "(allow sysctl-read)",
            # permissive reads; secrets are carved back out LAST, below
            '(allow file-read* (subpath "/"))',
        ]
    # per writable scope: allow writes -- UNLESS --ro, which emits NO write SCOPE at
    # all so even the scratch default is denied (R21).
    if not scope.ro:
        if restricted and scope.writes:
            # the write scopes are readable too: the allowlist above grants no
            # read under them
            lines.append("(allow file-read* %s)" % " ".join(
                '(subpath "%s")' % _sbpl_path(path) for path in scope.writes))
        for path in scope.writes:
            lines.append('(allow file-write* (subpath "%s"))' % _sbpl_path(path))
        if restricted and scope.writes:
            # an ACL entry would outlive the run and widen the owner's own
            # access; ONLY file-write-acl -- file-write-flags breaks
            # shutil.copy2/copytree (the owner clears uchg with lchflags(0)),
            # and mode/xattr stay legal (R2:S-H1b, M0:8)
            lines.append("(deny file-write-acl %s)" % " ".join(
                '(subpath "%s")' % _sbpl_path(path) for path in scope.writes))
            # the depth cap: no create at level 101 below a write scope, so a
            # tree too deep for the cleanup to walk cannot be built in place.
            # The group is written out LITERALLY 100 times -- a {100}
            # quantifier compiles and silently never matches (M0:9).
            # Rename-chaining is NOT bounded by it (KD-18 flatten, M0:14).
            for path in scope.writes:
                lines.append('(deny file-write-create (regex #"^%s/%s"))'
                             % (_depth_cap_regex(_sbpl_path(path)),
                                "[^/]+/" * _DEPTH_CAP_LEVELS))
    if restricted:
        # Restricted mode emits its OWN /dev/null rule, read AND write: bash's
        # background jobs and node's uv_loop_init open it, and the allowlist
        # grants no read of it otherwise (M0:5). Never the legacy line below.
        lines.append('(allow file-read* file-write* (literal "/dev/null"))')
    else:
        # The one write-allow --ro keeps: the /dev/null sink, as a LITERAL
        # (nothing else in /dev). Under (deny default) it was not writable, so
        # os.open("/dev/null", O_WRONLY|O_RDWR) failed EPERM -- and with it every
        # subprocess spawned with stdin=DEVNULL, which opens it O_RDWR (measured:
        # every git-calling function of an MCP child under `sbx --write .`).
        # bwrap's fresh /dev keeps /dev/null writable even under --ro, so this is
        # parity, not a widening: a sink can neither persist nor exfiltrate. No
        # deny below names a path covering it.
        lines.append('(allow file-write* (literal "/dev/null"))')
    # LAST, so last-match-wins makes them win over the permissive read-allow: deny
    # BOTH read and write for every DIRECTORY secret, even inside an allowed write
    # scope (R16, R17, R22, R22b). The per-FILE secrets (the .git/config masks) are
    # emitted separately, AFTER the carve-outs -- see below.
    for secret, is_dir in scope.secret_paths or ():
        if is_dir:
            lines.append('(deny file-read* (subpath "%s"))' % _sbpl_path(secret))
            lines.append('(deny file-write* (subpath "%s"))' % secret)
    # AFTER the directory secrets, so last-match-wins hands READ back for these named
    # subtrees of an otherwise-denied secret (this repo's own tooling under
    # ~/.claude). READ ONLY -- no file-write* allow is emitted, so the ~/.claude
    # write-deny above is untouched and everything NOT named here (projects,
    # settings*.json, .credentials.json, todos, history.jsonl, and anything added
    # under ~/.claude later) stays hidden: the carve-out is fail-closed by
    # enumeration. Restricted mode emits NONE: a carve-out is a READ grant, and
    # restricted reads are an allowlist (FR-1).
    for path in () if restricted else scope.carveouts or ():
        lines.append('(allow file-read* (subpath "%s"))' % _sbpl_path(path))
    # AFTER the carve-outs: the per-FILE secrets (every ancestor .git/config). A
    # carve-out is a SUBTREE read-allow, so on a copy-deployed install -- where
    # ~/.claude/skills holds real directories, not symlinks into a repo -- a git
    # checkout under it has a .git/config INSIDE the carve-out, and a mask emitted
    # before the carve-out loses to it (last match wins): the git remote
    # credentials were readable (measured live, ADR 0007 Consequences). A file mask
    # only ever narrows, so moving it later cannot re-open anything a carve-out was
    # meant to keep shut.
    for secret, is_dir in scope.secret_paths or ():
        if not is_dir:
            lines.append('(deny file-read* (subpath "%s"))' % _sbpl_path(secret))
            lines.append('(deny file-write* (subpath "%s"))' % secret)
    # THE LAST file rules, and every one of them is a DENY: the write-only shadow
    # set. ~/.claude is denied under the spelling `~/.claude`, but on a host where
    # ~/.claude/hooks is a SYMLINK into a repo, the SAME directory is also spelled
    # <repo>/ClaudeCode/hooks -- and that spelling contains no `.claude` component,
    # so the deny above never matched it. Under `--write .` the repo spelling was
    # WRITABLE while the ~/.claude spelling was denied: a sandboxed command could
    # rewrite its own PreToolUse gate through the back door (measured live). These
    # lines deny file-write* on the realpath TARGETS, which is the spelling the
    # kernel actually checks for the repo-side path. WRITE only -- no file-read*
    # deny is emitted, because the targets are the plugin tree and the repo itself,
    # which must stay readable (that is what carveouts above is for).
    for path in scope.shadow_write_denies or ():
        lines.append('(deny file-write* (subpath "%s"))' % _sbpl_path(path))
    # Network: EXPLICIT in both directions. (deny default) at the top already denies
    # the network, so merely omitting (deny network*) under --net left the flag inert
    # on macOS -- only (allow network*) actually grants it (R18).
    if scope.egress_socket is not None:
        raise ValueError("--egress-socket is the bwrap endpoint; Seatbelt "
                         "takes --egress-port")
    if scope.net and scope.egress_port is not None:
        raise ValueError("--egress-port cannot be combined with --net")
    if scope.net:
        lines.append("(allow network*)")
    else:
        lines.append("(deny network*)")
        if scope.egress_port is not None:
            lines.append(_seatbelt_egress_rule(scope))
    profile = "\n".join(lines)
    return ["sandbox-exec", "-p", profile, *scope.argv]


def _seatbelt_egress_rule(scope):
    """The ONE network allow of a restricted Seatbelt run with an egress
    endpoint, emitted AFTER (deny network*) so last-match-wins grants
    exactly it -> `(allow network-outbound (remote tcp "localhost:N"))`.

    Measured (M0, macOS 14.2.1): `remote tcp`/`remote ip` with host
    "localhost" reach 127.0.0.1:N (and [::1]:N -- the caller holds both)
    and nothing else -- another loopback port, an outside address, UDP, the
    mDNSResponder unix socket and DNS all stay denied, and a listen() is
    still EPERM; a "127.0.0.1" host is refused by the SBPL compiler ("host
    must be * or localhost"). `tcp`, not `ip`: no UDP to that port either.
    Restricted mode only, an int port 1..65535 (never a bool); anything
    else is a ValueError (exit 3). Pure."""
    port = scope.egress_port
    if not scope.restrict_reads:
        raise ValueError("--egress-port requires --restrict-reads")
    if isinstance(port, bool) or not isinstance(port, int) \
            or not 1 <= port <= 65535:
        raise ValueError("--egress-port %r is not a port 1..65535" % (port,))
    return '(allow network-outbound (remote tcp "localhost:%d"))' % port


def _bwrap_argv(scope):
    """Pure Linux bwrap builder (task-005): a Scope -> the bwrap argv LIST (never a
    shell string -- argv-as-list is the injection-safe construction). Order:
      --ro-bind / /  (read-all host) / --dev /dev --remount-ro /dev / UNLESS
      scope.net --tmpfs per SOCKET_DIRS entry, plus --ro-bind <cwd> <cwd> when the
      cwd lies under /tmp (under the others: ValueError, refused) (R-0061) / per
      writable
      scope --bind <canonical> <canonical> UNLESS scope.ro (R21: then no writable bind) / per secret_paths
      entry a mask layered AFTER the binds so it WINS over the ro-bind of /
      (R16/R17/R22/R22b) -- the mask PRIMITIVE is chosen by the entry's own
      `is_dir` BIT: a DIRECTORY secret gets --tmpfs <p>, a regular-FILE secret (the
      .git/config entries) gets --ro-bind-data <fd> <p> because --tmpfs needs a
      directory mountpoint (a file -> bwrap ensure_dir() ENOTDIR -> die() BEFORE
      exec) -- the DIRECTORY masks here, the FILE masks last of the binds / per
      scope.carveouts entry --ro-bind <p> <p> layered AFTER the directory masks so
      the LATER mount wins and the subtree is readable again (read-only, so it gains
      no write) / per scope.shadow_write_denies entry --ro-bind <realpath>
      <realpath>, re-mounting the divergent spelling read-only / per FILE secret the
      --ro-bind-data <fd> mask, LAST of the binds, so a .git/config inside a
      carve-out or a shadow subtree stays masked (ADR 0007; itself read-only, so
      the shadows' write-deny still stands) / --remount-ro per masked socket dir /
      --unshare-pid --unshare-ipc + --proc /proc / --unshare-net UNLESS scope.net
      (R18) / --new-session / --die-with-parent / --clearenv + --setenv K V per
      sorted key when scope.env is a dict (--clean-env) / the `--` end-of-options
      terminator / then *scope.argv.

    Mount ORDER is load-bearing in every direction here: bwrap applies filesystem
    operations strictly in argv order and a LATER operation on the same path wins, so
    a mask must come after the binds to hide a secret inside a writable scope, a
    carve-out must come after the masks or the --tmpfs over ~/.claude would bury it
    again, a shadow write-deny must come after the writable --bind whose spelling it
    is revoking, and a file mask must come after every carve-out and shadow subtree
    that contains it or that later subtree mount would bury the mask. (Only the SOURCE of a bind is resolved in the pre-pivot
    filesystem; the DEST is resolved in the new root, which is why re-binding a path
    onto ITSELF read-only is the correct way to drop write access to it.)

    --unshare-pid + --proc /proc are one unit and a CONTAINMENT rule, not hygiene.
    `--ro-bind / /` imports the HOST /proc recursively, and /proc/<pid>/root/<any>
    resolves in the host mount namespace -- so every --tmpfs mask above can be walked
    around through it, and /proc/<pid>/environ leaks other processes' secrets. A
    fresh procfs is the fix, and the kernel only yields one to a process that owns
    its PID namespace, which is why --unshare-pid comes with it rather than being
    optional. --unshare-pid does NOT make the target PID 1: bwrap keeps that role
    itself and reaps, so an ordinary build/test command is unaffected. Namespace
    flags are order-insensitive (they are applied before any mount); --proc is a
    MOUNT and is therefore emitted after every bind and mask, so nothing can re-mount
    the host /proc over it.

    seccomp is an OFF-by-default `if scope.seccomp:` branch INSIDE this function
    (locked decision 8 / NFR-9), taken only under `--seccomp`: it emits
    `--seccomp <fd>` for the program main() already wrote to an inheritable fd
    (scope.seccomp_fd), and REFUSES when that fd is missing or not a plain
    non-negative int -- never an unfiltered argv for a filtered request, and never
    a caller-supplied string spliced into argv. Pure: no I/O -- the is_dir bit rides
    in on the secret set instead of being stat'ed here, and the program fd and the
    file-mask fds ride in as numbers. The deny set and the carve-out set are
    read off scope.secret_paths / scope.carveouts (both resolved ONCE in main()), so
    this builder is side-effect-free.

    Restricted mode (scope.restrict_reads, ADR 0031) starts from an EMPTY root:
    no `--ro-bind / /`; the scope.linux_base entries instead (--ro-bind p p, or
    --symlink <value> p for a usr-merge link) / per read rule
    NOT covered by a base bind: a symlink -> --symlink <value> <spelling>, a dir
    or file -> --ro-bind <spelling> <spelling>; a read under /run, /var/snap or
    /tmp is refused (ValueError) -- the socket tmpfs would bury it and
    re-binding it would reopen the daemons / the same --dev, then the socket
    tmpfs sequence, AFTER the reads, so an ancestor read (`--read /`) buries
    neither the fresh /dev (H2) nor the socket tmpfs (P2 residual) /
    writes and secret masks as above / NO carve-outs / a shadow re-bind ONLY
    for a target inside a write scope -- outside one, on an empty root, it would
    be a READ grant (C-H4) / file masks / --proc and the namespaces, plus
    --unshare-uts --hostname sbx and --unshare-cgroup-try / --new-session
    --die-with-parent / --clearenv + --setenv K V per sorted key when scope.env
    is a dict / --chdir <cwd> / seccomp / `--` / *scope.argv.

    Egress (scope.egress_socket, restricted only): ONE `--ro-bind <socket>
    EGRESS_SOCKET_DEST` right after the socket tmpfs (the DEST is outside
    every socket directory, so that logic is untouched), --unshare-net kept,
    and the target after `--` wrapped as `<egress_python> -I -S -B -c
    EGRESS_FORWARDER EGRESS_FORWARD_PORT EGRESS_SOCKET_DEST -- *scope.argv`.
    An egress socket outside restricted mode, beside --net, without a
    forwarder interpreter, or an egress PORT (the Seatbelt endpoint) is a
    ValueError (exit 3).
    """
    restricted = scope.restrict_reads
    if scope.egress_port is not None:
        raise ValueError("--egress-port is the Seatbelt endpoint; bwrap takes "
                         "--egress-socket")
    if scope.egress_socket is not None:
        if not restricted:
            raise ValueError("--egress-socket requires --restrict-reads")
        if scope.net:
            raise ValueError("--egress-socket cannot be combined with --net")
        if not isinstance(scope.egress_python, str) \
                or not scope.egress_python.startswith("/"):
            raise ValueError("--egress-socket: no forwarder interpreter "
                             "resolved; refusing an unwrapped target")
    if restricted:
        # the base filesystem only (the system trees and the loader's /etc
        # entries); a usr-merge link is re-created as a link, never followed
        argv = ["bwrap"]
        for entry in scope.linux_base:
            if entry[0] == "symlink":
                argv += ["--symlink", entry[1], entry[2]]
            else:
                argv += ["--ro-bind", entry[1], entry[1]]
    else:
        argv = ["bwrap", "--ro-bind", "/", "/"]
    # A fresh minimal /dev (null, zero, full, random, urandom, tty, pts): every bind
    # but --dev-bind is nodev, so the host /dev imported by `--ro-bind / /` is
    # EACCES on every node (measured: `git --version` rc 128 on /dev/null).
    # --remount-ro makes the tmpfs read-only (no new files in /dev, /dev/shm); it is
    # not recursive, so the device nodes and the private devpts stay writable,
    # which leaves no persistent state. Legacy: FIRST, so no later mount under
    # /dev is buried (byte-identical argv, D4). Restricted: AFTER the read binds
    # (below), so a read covering /dev (`--read /`, `--read /dev`) cannot ro-bind
    # the host /dev -- /dev/shm, /dev/mqueue -- over it (round-3 H2).
    dev = ["--dev", "/dev", "--remount-ro", "/dev"]
    if not restricted:
        argv += dev
    # R-0061: without --net, an EMPTY tmpfs over each pathname-socket directory --
    # BEFORE every bind and mask, so a --write scope, a secret mask or a carve-out
    # under one of them lands on top and wins. A cwd under /tmp is re-bound
    # read-only so the project does not vanish (bwrap would silently chdir
    # elsewhere); its own sockets come back with it, the declared "sockets inside
    # the project" limit. A cwd under /run or /var/snap is REFUSED instead: a
    # re-bind there would reopen exactly the daemons this hides (cwd=/run/user/<uid>
    # -> D-Bus, gpg-agent). --net skips all of this: it reopens unix sockets on
    # macOS too, and /etc/resolv.conf points into /run on systemd-resolved hosts.
    sockets = () if scope.net else SOCKET_DIRS

    def _socket_mounts():
        out = []
        for d in sockets:
            out += ["--tmpfs", d]
        for d in sockets:
            if scope.cwd and scope.cwd.startswith(d + "/"):
                if d != "/tmp":
                    raise ValueError(
                        "refusing to run from %r: it lies under %s, whose sockets "
                        "a re-bind would reopen; run sbx from elsewhere"
                        % (scope.cwd, d))
                out += ["--ro-bind", scope.cwd, scope.cwd]
        return out
    # Legacy: the socket tmpfs right after /dev (byte-identical argv, D4).
    if not restricted:
        argv += _socket_mounts()
    # Restricted: the read allowlist, BEFORE the socket tmpfs and the writable
    # binds (so a write scope over a read wins). A read that is an ANCESTOR of
    # a socket directory (`--read /`, `--read /var`) would otherwise bury the
    # tmpfs and re-expose /run/docker.sock, D-Bus, lxd -- restricted wider than
    # legacy (P2 residual). A read UNDER a socket directory is refused here
    # (and by socket_read_refusal), so the tmpfs after it hides no granted
    # path. A spelling under a base bind is already visible and is not mounted
    # again. The spelling is the DEST and the SOURCE alike -- never realpath'd
    # (KD-14).
    if restricted:
        bound = [entry[-1] for entry in scope.linux_base]
        for path, kind, value in scope.read_rules:
            if any(_covered(path, d) for d in SOCKET_DIRS):
                raise ValueError(
                    "refusing --read %r: it lies under a socket directory "
                    "(/run, /tmp, /var/snap) the sandbox hides" % (path,))
            if any(_covered(path, b) for b in bound):
                continue
            if kind == "symlink":
                argv += ["--symlink", value, path]
            else:
                argv += ["--ro-bind", path, path]
        # the fresh /dev and the socket tmpfs AFTER every base and read bind:
        # no read overlays either (H2, P2 residual)
        argv += dev
        argv += _socket_mounts()
        # egress: the ONE socket, at a fixed path outside the socket dirs
        if scope.egress_socket is not None:
            argv += ["--ro-bind", scope.egress_socket, EGRESS_SOCKET_DEST]
    # per writable scope: read-write bind -- UNLESS --ro, which emits NO writable
    # bind at all so even the scratch default is denied (R21).
    if not scope.ro:
        for path in scope.writes:
            argv += ["--bind", path, path]
    # per secret: a mask layered AFTER the binds so it WINS over the ro-bind of /
    # -- hides the secret from both read and write even inside an allowed write
    # scope (R16, R17, R22, R22b). The mask PRIMITIVE is chosen by the entry's own
    # `is_dir` BIT, resolved by secret_paths() at the one place that already stats
    # the path, so this builder stays pure (no I/O):
    #   * a DIRECTORY secret (the home-anchored ~/.ssh .. ~/.claude) -> --tmpfs <p>,
    #     which is the correct primitive only for a directory mountpoint.
    #   * a regular-FILE secret (the .git/config of every ancestor repo) ->
    #     --ro-bind-data <fd> <p>, the fd on /dev/null: an EMPTY read-only file, so
    #     reads return empty and writes are DENIED (R17/R22 preserved). --tmpfs on a
    #     regular file makes bwrap die() with ENOTDIR BEFORE exec, and `--ro-bind
    #     /dev/null <p>` is nodev, i.e. EACCES rather than empty (measured).
    # The bit replaces the old `endswith(".git/config")` name heuristic outright:
    # STRUCTURE is now read from the filesystem once, not guessed from a suffix.
    # The FILE masks are layered separately, LAST of the binds -- see below.
    for secret, is_dir in scope.secret_paths or ():
        if is_dir:
            argv += ["--tmpfs", secret]
    # per carve-out: a READ-ONLY bind layered AFTER the directory masks, because the
    # LATER mount wins -- this is what makes the named subtrees of ~/.claude (this repo's
    # own tooling) readable again after the --tmpfs above buried them. --ro-bind is
    # exactly the wanted semantics: readable, NOT writable, so ~/.claude keeps its
    # write-deny and every unnamed path under it stays masked (fail-closed by
    # enumeration). Each carve-out EXISTS (carveout_paths() filters), so bwrap never
    # has to mkdir a mountpoint under the read-only root. Restricted mode binds
    # NONE: a carve-out is a READ grant, and restricted reads are an allowlist.
    for path in () if restricted else scope.carveouts or ():
        argv += ["--ro-bind", path, path]
    # per shadow target: re-bind the path ONTO ITSELF read-only, after the carve-outs
    # so the later mount wins over the writable --bind above. ~/.claude is masked
    # under the ~/.claude spelling, but on a host where ~/.claude/hooks is a symlink
    # into a repo the same directory is ALSO spelled <repo>/ClaudeCode/hooks, and a
    # `--bind <repo> <repo>` makes that spelling writable -- the sandboxed command
    # can then rewrite its own gate. A read-only bind is exactly the semantics wanted
    # here: still READABLE (unlike --tmpfs, which would bury the repo and the plugin
    # tree the carve-out just reopened), no longer WRITABLE. Each target EXISTS
    # (shadow_write_denies() filters), so bwrap never has to mkdir a mountpoint under
    # the read-only root. Restricted mode re-binds ONLY a target inside a write
    # scope: outside one there is no writable spelling to revoke, and on the
    # empty root the re-bind would be a READ grant (C-H4 = S-H1).
    for path in scope.shadow_write_denies or ():
        if restricted and not any(_covered(path, w) for w in scope.writes):
            continue
        argv += ["--ro-bind", path, path]
    # per FILE secret (every ancestor .git/config): the empty-file mask, LAST of the
    # binds -- after the carve-outs AND the shadow re-mounts. Both are subtree binds
    # whose SOURCE is resolved in the pristine host root, so they carry no mask with
    # them: a .git/config under ~/.claude/skills on a copy-deployed install (R-0005),
    # or inside a checkout that a ~/.claude symlink resolves to (R-0031), was buried
    # by the later subtree mount and readable again (ADR 0007 Consequences). Emitting
    # it after the shadows keeps their write protection: the mask is itself a
    # READ-ONLY bind, so the final mount on every covered path is still read-only and
    # the last word on writes is still a deny. One fd per mask (main() opens them);
    # a missing one refuses rather than leave a secret unmasked.
    files = [secret for secret, is_dir in scope.secret_paths or () if not is_dir]
    fds = scope.file_mask_fds or ()
    if len(fds) != len(files):
        raise ValueError("%d file secret(s) but %d mask fd(s); refusing to leave a "
                         "secret unmasked" % (len(files), len(fds)))
    for secret, fd in zip(files, fds):
        argv += ["--ro-bind-data", str(fd), secret]
    # The socket tmpfs read-only, AFTER the last bind/mask (their mountpoints are
    # created in it first). Not recursive, like /dev: the binds on top keep their
    # own mode, and the hidden directory stays as unwritable as the host one was.
    for d in sockets:
        argv += ["--remount-ro", d]
    # A FRESH procfs in a PID namespace we own. Without this, `--ro-bind / /` above
    # imports the HOST /proc, and /proc/<pid>/root/<path> resolves in the HOST mount
    # namespace -- which walks around every --tmpfs mask emitted above -- while
    # /proc/<pid>/environ leaks other processes' environments. --proc is a mount, so
    # it is emitted after every bind and mask (last mount wins); --unshare-pid is a
    # namespace flag, order-insensitive, and is REQUIRED for the mount: the kernel
    # only grants a fresh procfs to a process in its own PID namespace. bwrap itself
    # stays PID 1 and reaps, so the target is an ordinary child process.
    # --unshare-ipc: SysV shm/sem/msg and POSIX mqueues are otherwise the host's.
    argv += ["--unshare-pid", "--unshare-ipc", "--proc", "/proc"]
    # network unshared by default; --net omits this (R18).
    if not scope.net:
        argv.append("--unshare-net")
    # Restricted: the host name and the cgroup view are the host's otherwise
    # (-try: a kernel without cgroup namespaces still runs).
    if restricted:
        argv += ["--unshare-uts", "--hostname", "sbx", "--unshare-cgroup-try"]
    # setsid(): no controlling tty, so /dev/tty is ENXIO and TIOCSTI cannot inject.
    argv.append("--new-session")
    argv.append("--die-with-parent")
    # a clean env (--clean-env, restricted or not -- FR-4): bwrap clears it and
    # sets each validated pair, sorted so the argv is deterministic (values
    # never reach a log, only argv). bwrap itself is exec'd with {} (C-M7), so
    # these flags are the ONLY way the --env pairs reach the target; env None
    # (inherit) emits nothing and keeps the legacy argv byte-identical (D4).
    if scope.env is not None:
        argv.append("--clearenv")
        for key in sorted(scope.env):
            argv += ["--setenv", key, scope.env[key]]
    # the empty root has no host cwd to inherit
    if restricted and scope.cwd:
        argv += ["--chdir", scope.cwd]
    # seccomp: the OFF-by-default syscall filter (locked decision 8 / NFR-9, R-0003),
    # set only by `--seccomp`. bwrap reads a compiled classic-BPF program from the
    # fd and installs it in the target right before exec. The fd was opened and
    # filled by main() (_seccomp_fd), so this branch only prints its NUMBER. With
    # the flag set and no usable fd there is no program to pass, so it refuses
    # rather than silently running without the promised filtering. bool is an int
    # subclass and is refused on purpose: True would print "True".
    if scope.seccomp:
        fd = scope.seccomp_fd
        if isinstance(fd, bool) or not isinstance(fd, int) or fd < 0:
            raise ValueError(
                "--seccomp requested but no BPF program fd was resolved (got %r); "
                "refusing to build an unfiltered bwrap argv" % (fd,))
        argv += ["--seccomp", str(fd)]
    argv.append("--")             # end-of-options terminator (bubblewrap honors "--")
    if scope.egress_socket is not None:
        # the forwarder binds 127.0.0.1:EGRESS_FORWARD_PORT, forks its relay
        # and execs the target in place (EGRESS_FORWARDER)
        argv += [scope.egress_python, "-I", "-S", "-B", "-c", EGRESS_FORWARDER,
                 str(EGRESS_FORWARD_PORT), EGRESS_SOCKET_DEST, "--"]
    argv += scope.argv
    return argv


def _covered(path, bound):
    """True when `path` is `bound` or lies below it -- separator-safe
    (os.path.commonpath, like inside_project): /wx is NOT under /w. Pure."""
    return os.path.commonpath([path, bound]) == bound


# platform key (a sys.platform PREFIX) -> pure argv builder (KD-3, NFR-2). The
# two builder bodies are filled by tasks 004/005; the dict itself is pure and
# import-safe. BACKENDS.get(<unknown key>) is the fail-closed default (None).
BACKENDS = {
    "darwin": _seatbelt_argv,
    "linux": _bwrap_argv,
}

# platform key -> the sandbox engine binary whose presence is REQUIRED. Adding a
# third OS later touches this map, BACKENDS, and one builder -- nothing else
# (NFR-9, localized platform extension).
ENGINE_BINARY = {
    "darwin": "sandbox-exec",
    "linux": "bwrap",
}


def _platform_key(platform):
    """Map a sys.platform string to a BACKENDS key by PREFIX, or None if unknown.

    "darwin" -> "darwin"; "linux"/"linux2" -> "linux"; "win32" and anything else
    -> None. None is the fail-closed default: BACKENDS.get(None) is None, so an
    unknown platform resolves no backend and is refused by _detect_engine.
    """
    for key in BACKENDS:
        if platform.startswith(key):
            return key
    return None


def _detect_engine():
    """Resolve (builder, binary_path) FAIL-CLOSED (KD-3, NFR-1, R20).

    On an unknown platform (no BACKENDS entry) OR when the required sandbox
    binary is not found on PATH, write a one-line reason to stderr and
    sys.exit(non-zero) WITHOUT constructing or running any target. There is NO
    unsandboxed fallback, ever. Runs only from main() (behind __main__), never at
    import, so the module stays import-side-effect-free (M3).
    """
    key = _platform_key(sys.platform)
    builder = BACKENDS.get(key)
    if builder is None:
        sys.stderr.write(
            "sbx: error: no sandbox backend for platform %r; "
            "refusing to run unsandboxed (fail-closed)\n" % (sys.platform,))
        sys.exit(3)
    binary = ENGINE_BINARY[key]
    path = shutil.which(binary)
    if path is None:
        sys.stderr.write(
            "sbx: error: sandbox binary %r not found on PATH; "
            "refusing to run unsandboxed (fail-closed)\n" % (binary,))
        sys.exit(3)
    return builder, path


def _split_argv(argv):
    """Slice `argv` at the FIRST bare `--` ourselves (argparse.REMAINDER is brittle).

    Returns (left, target): `left` is fed to argparse; `target` is kept verbatim as
    the command to run. `target` is None when there is no `--` at all, and [] when
    `--` is present but nothing follows it -- both are usage errors for the caller.
    """
    for i, tok in enumerate(argv):
        if tok == "--":
            return argv[:i], argv[i + 1:]
    return argv, None


class _SbxArgumentParser(argparse.ArgumentParser):
    """argparse with one change: an "unrecognized arguments" error names only
    the FLAG part of each stray token, never a value. argparse echoes the raw
    tokens, so a mistyped `--envv KEY=secret` or `--foo=secret` would otherwise
    put an environment value on stderr (sbx_restrict:D2 -- env values stay off
    stderr on EVERY path, parser errors included)."""

    _UNRECOGNIZED = "unrecognized arguments: "

    def error(self, message):
        if message.startswith(self._UNRECOGNIZED):
            names = [tok.split("=", 1)[0]
                     for tok in message[len(self._UNRECOGNIZED):].split(" ")
                     if tok.startswith("-")]
            message = "unrecognized arguments (values not echoed): %s" % (
                " ".join(names) or "<positional>",)
        super().error(message)


def _build_parser():
    """The sbx flag grammar (everything LEFT of the first bare `--`).

    allow_abbrev=False (C-L1): an abbreviation such as `--restrict`, `--rlimit-a`
    or `--dry` would otherwise silently resolve to a full flag the gate never
    saw; it is now a usage error (exit 2). Every new value is type=str and is
    validated by sbx's own parse_* functions, never by argparse coercion.
    """
    p = _SbxArgumentParser(
        prog="sbx",
        usage=USAGE,
        description="Run <cmd> inside an OS sandbox (default-deny writes, no network).",
        allow_abbrev=False,
    )
    p.add_argument("--write", action="append", default=[], metavar="DIR",
                   help="add a writable scope (repeatable); '.' opts into the repo")
    p.add_argument("--net", action="store_true",
                   help="allow network access (denied by default)")
    p.add_argument("--ro", action="store_true",
                   help="deny ALL writes, including the default scratch scope")
    p.add_argument("--seccomp", action="store_true",
                   help="Linux x86_64 only: add the syscall allowlist (EPERM for "
                        "anything else); refused on any other platform")
    p.add_argument("--dry-run", action="store_true",
                   help="print the resolved plan and exit WITHOUT running anything")
    # Restricted mode (ADR 0031).
    p.add_argument("--restrict-reads", action="store_true",
                   help="restrict reads to an allowlist (system base + --read + "
                        "write scopes) and filter process-exec")
    p.add_argument("--read", action="append", default=[], metavar="PATH",
                   type=str, help="add an absolute readable path (repeatable; "
                                  "requires --restrict-reads)")
    p.add_argument("--exec", action="append", default=[], metavar="PATH",
                   type=str, help="add an absolute exec-able path (repeatable; "
                                  "requires --restrict-reads)")
    p.add_argument("--clean-env", action="store_true",
                   help="start the target with an empty environment plus --env")
    p.add_argument("--env", action="append", default=[], metavar="KEY=VALUE",
                   type=str, help="set one environment variable (repeatable; "
                                  "requires --clean-env); sbx never prints a "
                                  "value, but values travel in the sandbox "
                                  "engine's argv and are visible in the "
                                  "process list -- pass no secret here")
    p.add_argument("--timeout", metavar="SECONDS", type=str,
                   help="supervise the target and kill it after SECONDS")
    p.add_argument("--status-fd", metavar="FD", type=str,
                   help="write the supervisor status record to FD (>= 3; "
                        "requires --timeout)")
    for name in ("as", "cpu", "nproc", "fsize", "nofile", "core"):
        p.add_argument("--rlimit-" + name, metavar="N", type=str,
                       help="strict RLIMIT_%s (decimal; refused, not skipped, "
                            "when the kernel rejects it)%s"
                            % (name.upper(),
                               "; '+N' = N above the uid's current count"
                               if name == "nproc" else ""))
    # Egress: the ONE endpoint (the caller's allowlisting proxy) a restricted
    # run may reach. Never auto-allowed by the gate (_PROMPT_FLAGS).
    p.add_argument("--egress-port", metavar="N", type=str,
                   help="macOS: let the target reach 127.0.0.1:N and nothing "
                        "else (requires --restrict-reads; not with --net)")
    p.add_argument("--egress-socket", metavar="PATH", type=str,
                   help="Linux: bind your own unix socket PATH into the "
                        "sandbox and forward 127.0.0.1:%d inside to it "
                        "(requires --restrict-reads; not with --net)"
                        % EGRESS_FORWARD_PORT)
    return p


# ---------------------------------------------------------------------------
# Pure injection / secret / realpath guard layer (task-003).
#
# This is the SHARED-CONTRACT core and a SECURITY BOUNDARY. resolve_scope and
# project_root are BYTE-FOR-BYTE the rules the gate (ClaudeCode/hooks/sbx-gate.py)
# applies -- the gate imports NOTHING (P8), so the two copies are DELIBERATELY
# DUPLICATED, not shared, and task-008's cross-file parity test pins them: a
# one-sided edit reintroduces the H1 gate/helper divergence == a containment
# escape (H-A / NFR-8). Do NOT try to import from the gate or share a module.
#
# Every definition here is PURE and import-side-effect-free (M3): no exec, no
# setrlimit, no makedirs, no filesystem MUTATION at import. secret_paths,
# carveout_paths and shadow_write_denies read the filesystem (existence, the is_dir
# bit the bwrap builder needs, and the symlink realpaths) ONLY when CALLED at
# runtime. They are the ONLY readers: both backend builders are pure functions of
# what these three return.


def resolve_scope(dir_arg, base):
    """KD-7 shared rule -- byte-identical copy of the gate's resolve_scope (P8).

    expanduser FIRST (so "~" -> $HOME), then join against `base` (join drops
    `base` when the expanded arg is absolute), then realpath. `base` is always
    `cwd`. IDENTICAL on both sides -- the gate imports nothing, so this is
    duplicated, not shared (parity test, task-008).
    """
    return os.path.realpath(os.path.join(base, os.path.expanduser(dir_arg)))


def project_root(start):
    """KD-8 shared rule -- byte-identical copy of the gate's project_root (P8).

    Nearest ancestor of `start` (inclusive) that contains a `.git` entry; if none
    is found walking up to the filesystem root, `start` itself. `start` is always
    `cwd`; `cwd` is NOT assumed to be the repo root (a Bash cwd may be any
    subdirectory). Feeds inside_project containment; does NOT feed secret_paths --
    sec-MED-2's ancestor-.git walk owns the .git/config deny.
    """
    cur = os.path.realpath(start)
    while True:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:            # reached the filesystem root
            return os.path.realpath(start)
        cur = parent


def inside_project(path, root):
    """Separator-safe KD-8 containment (sec-MED-1 / A04): is `path` inside `root`?

    Uses os.path.commonpath (root itself allowed), NEVER a bare str.startswith --
    a raw prefix test false-allows a `/x/repo-evil` sibling of `/x/repo`
    ("/x/repo-evil".startswith("/x/repo") is True). This is the SAME test the
    gate's scope-containment applies (H1); part of the duplicated shared contract.
    Both `path` and `root` are expected to be realpath-resolved absolutes.
    """
    return os.path.commonpath([path, root]) == root


def secret_paths(cwd):
    """The single, pure, import-side-effect-free deny set (M-A / KD-2 / sec-MED-2).

    A FUNCTION, not a module-level constant, because the `.git/config` entries are
    cwd-derived and a module-level tuple evaluated at import has no `cwd`. Returns
    read+write-deny targets: the home-anchored `~/.ssh`, `~/.aws`, `~/.gnupg`,
    `~/.config/gh`, `~/.claude` (expanduser, cwd-independent) PLUS the `.git/config`
    of EVERY ancestor directory of `cwd` (inclusive) whose `<d>/.git/config` exists,
    walking from `cwd` up to the filesystem root -- NOT only project_root(cwd), so
    a decoy `cwd/.git` planted by a prior `--write .` run cannot relocate the
    anchor and un-protect the REAL repo-root `.git/config` (git remote creds).

    Each entry is a `(path, is_dir)` PAIR, not a bare string. The bit is resolved
    here because this function is ALREADY the one place that touches the filesystem
    (the existence filter below), and it is what keeps _bwrap_argv PURE: bwrap needs
    a DIRECTORY mountpoint for --tmpfs and a FILE mountpoint for --ro-bind-data,
    and the builder used to guess which was which from the path ending in
    `<sep>.git<sep>config`. That name heuristic is GONE -- structure is measured, not
    inferred, so a future file-shaped secret cannot be silently mis-masked into a
    pre-exec bwrap die().

    EXISTENCE-FILTERED, cross-platform-SAFE: only paths that EXIST at call time are
    returned. A secret that does not exist has NOTHING to protect (no file/dir to
    read), AND bwrap cannot create a mountpoint for a nonexistent path under its
    read-only `--ro-bind / /` root -- it dies "Can't mkdir <p>: Read-only file
    system" at setup, BEFORE exec, making sbx dead-on-arrival on Linux whenever a
    home secret (e.g. ~/.aws) or a walked `.git/config` is absent. macOS Seatbelt
    deny of a nonexistent path is a harmless no-op, so filtering removes NO real
    protection on either OS. The filter is the same runtime-only I/O the ancestor
    walk already performs, so M-A/M3 hold.

    Import-side-effect-free (M3): reads the filesystem (os.path.exists /
    os.path.isdir) ONLY when CALLED at runtime, never at import, and never mutates.
    ALL of the deny set's I/O lives here -- the two backend builders that consume the
    result perform none, which is the invariant that makes them offline-testable.
    """
    home = [
        os.path.expanduser("~/.ssh"),
        os.path.expanduser("~/.aws"),
        os.path.expanduser("~/.gnupg"),
        os.path.expanduser("~/.config/gh"),
        os.path.expanduser("~/.claude"),
    ]
    # existence filter (see above) + the is_dir bit the bwrap builder needs
    paths = [(p, os.path.isdir(p)) for p in home if os.path.exists(p)]
    cur = os.path.realpath(cwd)
    while True:                      # every ancestor .git, not just project_root
        config = os.path.join(cur, ".git", "config")
        if os.path.exists(config):   # a .git dir with no config file has nothing to
            paths.append(            # protect (and bwrap can't mkdir it) -> skip it
                (config, os.path.isdir(config)))
        parent = os.path.dirname(cur)
        if parent == cur:            # reached the filesystem root
            break
        cur = parent
    return tuple(paths)


def carveout_paths():
    """The read-ONLY carve-out set: the named subtrees of a DENIED secret that must
    stay READABLE inside the sandbox.

    `~/.claude` is a secret (it holds credentials, session transcripts, todos and --
    critically -- the hooks and settings that gate this very tool), so the deny set
    hides ALL of it. That also hid this repo's OWN tooling, which lives under it:
    `~/.claude/scripts/*.py` and `~/.claude/skills/**/scripts/*.py`. Measured live:
    every such script died with "Operation not permitted" under sbx. Splitting the
    two concerns -- deny the secret, carve the tooling back out for READ -- is what
    makes the sandbox usable for the scripts it was built to contain.

    The carve-out is READ-ONLY and FAIL-CLOSED BY ENUMERATION. Only these two named
    subdirectories open, and only for reading:
      * `~/.claude/skills`   the deployed skill trees (their scripts/ helpers)
      * `~/.claude/scripts`  the deployed standalone tooling
    Everything else under `~/.claude` stays unreadable -- `projects/`,
    `settings*.json`, `.credentials.json`, `todos/`, `history.jsonl`, and anything a
    future Claude Code version drops there, which is the point of enumerating what
    OPENS rather than what closes. And no carve-out ever grants WRITE: a sandboxed
    command that could write `~/.claude` could rewrite `settings.json` or `hooks/`,
    i.e. its own gate, which is the threat this whole feature exists to stop.

    EXISTENCE-FILTERED for the same reason secret_paths is: bwrap binds each entry as
    a mountpoint under a read-only `/`, and a nonexistent one makes it die at setup
    BEFORE exec. `expanduser` WITHOUT realpath, consistent with secret_paths -- the
    two sets must agree on how a path is spelled or a carve-out could fail to line up
    with the mask it is carving out of.

    Import-side-effect-free (M3): the filesystem read happens only when CALLED.
    """
    paths = [
        os.path.expanduser("~/.claude/skills"),
        os.path.expanduser("~/.claude/scripts"),
    ]
    return tuple(p for p in paths if os.path.exists(p))


def shadow_write_denies():
    """The WRITE-only deny set: the realpath TARGETS of every symlink that leads OUT
    of `~/.claude`. This closes NAME DIVERGENCE -- the containment escape that a
    path-spelling deny cannot see.

    MEASURED LIVE on this host, and reproducible with .claude/tmp/write-probe.py:
    `~/.claude/hooks` is a SYMLINK to `<repo>/ClaudeCode/hooks`, and settings.json
    registers the PreToolUse hooks under the `~/.claude/hooks/...` spelling. Under
    `sbx --write .` the deny on `~/.claude` matched the `.claude` spelling and denied
    it -- while the repo spelling of the SAME directory, which contains no `.claude`
    component at all, stayed WRITABLE. The probe wrote a marker into
    `<repo>/ClaudeCode/hooks/`, was refused at `~/.claude/hooks/`, and opened the
    live gate `<repo>/ClaudeCode/hooks/sbx-gate.py` for append. A sandboxed command
    that can rewrite its own gate is not sandboxed. Both Seatbelt subpath rules and
    bwrap mounts key on the path SPELLING, not the inode, so the only fix is to deny
    the other spelling too -- which means resolving it and naming it explicitly.

    WHAT IS WALKED: the DIRECT children of `~/.claude` and of each carve-out
    (`~/.claude/skills`, `~/.claude/scripts` -- taken from carveout_paths() so the
    two sets cannot drift apart; the carve-outs are precisely the subtrees the
    sandbox deliberately opens, hence precisely where a symlink out is dangerous).
    One level, not a recursive walk: a deployment farm links whole trees at the top,
    and an unbounded walk of ~/.claude would stat a session-transcript archive on
    every single sbx run.

    WHAT IS KEPT: only a symlink whose realpath LEAVES `~/.claude` (separator-safe
    containment via inside_project, against the REALPATH of ~/.claude since the
    target is itself realpath-resolved). A symlink that stays inside is no
    divergence -- the `~/.claude` deny already covers it under a spelling it matches.
    EXISTENCE-FILTERED like the other two sets: a broken link has nothing to protect,
    and bwrap cannot mkdir a mountpoint for it under the read-only root.

    WRITE-ONLY, NEVER READ. The targets here are the plugin tree and the repo itself
    (`<repo>/ClaudeCode`, `<repo>/Scripts`). A read-deny on them would re-hide
    exactly what carveout_paths() exists to open and would blind the sandbox to the
    repo it is running in. The consequence is intended and worth naming: under
    `sbx --write .` the linked trees become READ-ONLY. They are executable
    configuration -- hooks, MCP servers, skill scripts -- that a sandboxed command
    has no business rewriting.

    No injection filter is applied to the resolved targets HERE, deliberately: if
    one ever contains an SBPL metacharacter, the Seatbelt builder's _sbpl_path
    refuses the whole profile (exit 3) -- fail-CLOSED. (Trusting sandbox-exec to
    reject the parse was wrong: a crafted name parses as extra rules, P1.)
    Dropping the entry instead would be fail-open: a silently missing deny.

    Import-side-effect-free (M3): the listdir/lstat/realpath reads happen only when
    CALLED, never at import, and nothing is mutated. All of this set's I/O lives
    here, so both backend builders stay pure functions of what it returns.
    """
    claude = os.path.expanduser("~/.claude")
    claude_real = os.path.realpath(claude)
    targets = []
    for root in (claude,) + carveout_paths():
        try:
            names = sorted(os.listdir(root))
        except OSError:
            continue                       # absent or unreadable: nothing to enumerate
        for name in names:
            entry = os.path.join(root, name)
            if not os.path.islink(entry):
                continue                   # only a LINK can spell the same inode twice
            target = os.path.realpath(entry)
            if not os.path.exists(target):
                continue                   # broken link: no inode to protect
            if inside_project(target, claude_real):
                continue                   # stays inside; the ~/.claude deny covers it
            if target not in targets:      # a farm can link one tree under two names
                targets.append(target)
    return tuple(targets)


# The R14 injection floor: a raw-or-resolved scope carrying any of these could
# break out of the SBPL profile string or the bwrap argv, so canonicalize refuses
# it fail-closed. (The gate rejects the same class upstream via its METACHARS.)
# Every C0 control character and DEL are in the class too (P1): newline was the
# only one listed, yet a tab or a carriage return is just as foreign to a path
# and a profile string. _sbpl_path applies the same class at the builder.
_INJECT_CHARS = frozenset("\"'()\\") | frozenset(
    chr(code) for code in list(range(0x20)) + [0x7f])


def _tilde_ok(word):
    """G3 mirror of the gate's _tilde_ok: is every "~" in `word` one bash and
    os.path.expanduser read alike? Only a bare "~" or a leading "~/" qualifies;
    expanduser leaves "~+", "~-" and "~user" literal while bash expands them
    ($PWD, $OLDPWD, a home), so a "~" anywhere else is refused, never reasoned
    about. resolve_scope itself stays byte-identical to the gate's (P8)."""
    if "~" not in word:
        return True
    return word == "~" or (word.startswith("~/") and "~" not in word[1:])


def canonicalize(dir_arg, cwd=None):
    """Resolve a `--write` scope via the shared KD-7 resolve_scope, then REJECT
    (fail-closed, sys.exit non-zero) any raw OR resolved path containing " ' ( )
    backslash or a control character (R14 / NFR-4, P1), and any "~" other than
    a bare "~" or a leading "~/" (G3). Performs NO makedirs. `cwd` defaults to
    os.getcwd() so the pure layer can be exercised with a single argument.
    """
    if cwd is None:
        cwd = os.getcwd()
    if not _tilde_ok(dir_arg):
        sys.stderr.write(
            "sbx: error: refusing --write scope %r: a '~' is accepted only as "
            "a bare '~' or a leading '~/' (G3)\n" % (dir_arg,))
        sys.exit(2)
    resolved = resolve_scope(dir_arg, cwd)
    for candidate in (dir_arg, resolved):
        if any(ch in _INJECT_CHARS for ch in candidate):
            sys.stderr.write(
                "sbx: error: refusing --write scope %r: it contains a shell/SBPL "
                "metacharacter (one of \" ' ( ) \\ or a control character)\n"
                % (dir_arg,))
            sys.exit(2)
    reason = socket_write_refusal(resolved) or socket_under_refusal(resolved)
    if reason is not None:
        sys.stderr.write("sbx: error: refusing --write scope %r: %s\n"
                         % (dir_arg, reason))
        sys.exit(2)
    return resolved


def socket_write_refusal(path):
    """Round-3 H1: may `path` be a WRITE scope? -> None, or the refusal reason.

    A write scope is bound `--bind w w` AFTER the socket tmpfs, so one that is
    EQUAL TO or an ANCESTOR of a socket directory (`/`, `/var`, `/run`, `/tmp`)
    buries the tmpfs and leaves every host pathname socket writable and
    connectable. With cwd `/` (project_root falls back to the cwd when there is
    no .git) `--write .` is exactly that. `path` as spelled and as realpath'd is
    compared against each SOCKET_REFUSED_DIRS entry as spelled and as
    realpath'd (darwin: /var -> /private/var). Platform-neutral, so darwin
    refuses it too. A scope UNDER a socket directory (`--write /tmp/x`) is NOT
    refused here: it buries nothing above it and is an explicit, narrow grant.
    I/O: realpath only."""
    forms = {os.path.normpath(path), os.path.realpath(path)}
    for d in SOCKET_REFUSED_DIRS:
        for sock in {d, os.path.realpath(d)}:
            for w in forms:
                if _covered(sock, w):
                    return ("it is %sthe socket directory %s, and a write "
                            "bind there would bury the tmpfs that hides the "
                            "host sockets"
                            % ("" if sock == w else "an ancestor of ", sock))
    return None


def socket_under_refusal(path):
    """Round-3 R2: does `path` lie strictly UNDER /run, /var/run or /var/snap?
    -> None, or the refusal reason. A bind there is ordered after the socket
    tmpfs and re-exposes the daemons below it (/run/user/<uid>: D-Bus,
    ssh-agent, gpg-agent), the reason a cwd there is refused too. `path` as
    spelled and as realpath'd against each SOCKET_UNDER_REFUSED_DIRS entry as
    spelled and as realpath'd; EQUAL is socket_write_refusal's case. Not /tmp
    (see SOCKET_UNDER_REFUSED_DIRS). I/O: realpath only."""
    forms = {os.path.normpath(path), os.path.realpath(path)}
    for d in SOCKET_UNDER_REFUSED_DIRS:
        for sock in {d, os.path.realpath(d)}:
            for p in forms:
                if p != sock and _covered(p, sock):
                    return ("it lies under the socket directory %s, whose "
                            "sockets (D-Bus, ssh-agent, gpg-agent) a bind "
                            "there would re-expose" % sock)
    return None


def socket_bind_refusal(carveouts, shadows):
    """Round-3 R1: may every ~/.claude carve-out and shadow re-bind target be
    bound? -> None, or one refusal reason. Both are ro-bound AFTER the socket
    tmpfs (legacy bwrap), and a carve-out is expanduser'd only, so bwrap
    follows its source link: one that IS, is an ancestor of, or lies under a
    socket directory re-exposes the host sockets. The caller REFUSES (exit 3)
    -- dropping the entry would silently lose the deny for that spelling.
    Applied on both OSes and in both modes (the same lists feed Seatbelt).
    I/O: realpath only."""
    for kind, paths in (("carve-out", carveouts or ()),
                        ("shadow re-bind target", shadows or ())):
        for path in paths:
            reason = socket_write_refusal(path) or socket_under_refusal(path)
            if reason is not None:
                return ("the ~/.claude %s %r (realpath %r): %s"
                        % (kind, path, os.path.realpath(path), reason))
    return None


def floor_cwd(cwd):
    """The P1 cwd floor, applied ONCE in main() before any scope is computed:
    the working directory, AND its realpath, must carry no _INJECT_CHARS
    character -> `cwd` unchanged, else one stderr line and exit 3 (nothing is
    resolved or run).

    The cwd feeds the profile without passing through any flag check: its
    ancestors become the restricted metadata LITERALS, <cwd>/.claude/tmp is the
    default write SUBPATH in both modes, and every ancestor's .git/config is a
    deny -- so a directory named `a"))(allow file-write* (regex #"^"))...` was a
    write-anywhere rule. _sbpl_path refuses at the builder as well; this floor
    also covers --dry-run, which builds no profile."""
    for candidate in (cwd, os.path.realpath(cwd)):
        if any(ch in _INJECT_CHARS for ch in candidate):
            sys.stderr.write(
                "sbx: error: refusing to run from the working directory %r: it "
                "contains a shell/SBPL metacharacter (one of \" ' ( ) \\ or a "
                "control character); run sbx from elsewhere\n" % (cwd,))
            sys.exit(3)
    return cwd


def canonicalize_read(path_arg):
    """Canonicalize one `--read` / `--exec` spelling (restricted mode, ADR 0031):
    ABSOLUTE required (no cwd join, no `~` expansion -- the caller passes what it
    means), the same R14 injection floor as canonicalize (P2), then
    os.path.normpath ONLY. NEVER realpath (KD-14): the spelling IS the rule --
    a symlink stays a literal carrying its link value, and the caller passes
    every hop it needs. A refusal is one stderr line and exit 2.

    Pure: no filesystem access at all; existence is the resolver's job.
    """
    if not isinstance(path_arg, str) or not path_arg.startswith("/"):
        _usage_error("refusing read/exec path %r: it must be absolute"
                     % (path_arg,))
    if any(ch in _INJECT_CHARS for ch in path_arg):
        _usage_error("refusing read/exec path %r: it contains a shell/SBPL "
                     "metacharacter (one of \" ' ( ) \\ or a control "
                     "character)" % (path_arg,))
    path = os.path.normpath(path_arg)
    # POSIX normpath keeps a leading "//" (implementation-defined root); it names
    # the same directory as "/" on both supported OSes, so spell it "/".
    if path.startswith("//"):
        path = "/" + path.lstrip("/")
    return path


def scratch_scope(cwd):
    """The default writable scratch scope, NAMED but not created here (M3): it is
    <cwd>/.claude/tmp. task-006's runtime dispatch creates it with
    os.makedirs(..., exist_ok=True) behind __main__ -- never a shell mkdir, never
    at import.
    """
    return os.path.join(cwd, ".claude", "tmp")


def compute_writes(raw_writes, ro, cwd):
    """Pure writable-set computation (R21). `--ro` overrides everything to an EMPTY
    set (no scratch); with no `--write` the sole scope is the scratch default;
    otherwise each `--write DIR` is canonicalize()'d (KD-7 resolution + R14
    injection reject). NO makedirs here -- the pure layer only NAMES scopes (M3).
    The scratch default is cwd-derived, so a <cwd>/.claude/tmp planted as a
    symlink to `/` or `/var` would bury the socket tmpfs too (round-3 H1): it
    is refused like a hostile cwd, one stderr line and exit 3.
    """
    if ro:
        return []
    if not raw_writes:
        scratch = scratch_scope(cwd)
        reason = socket_write_refusal(scratch) or socket_under_refusal(scratch)
        if reason is not None:
            sys.stderr.write("sbx: error: refusing to run from %r: the default "
                             "scratch scope %r: %s\n" % (cwd, scratch, reason))
            sys.exit(3)
        return [scratch]
    return [canonicalize(d, cwd) for d in raw_writes]


# ---------------------------------------------------------------------------
# Restricted mode: pure value parsers and validators (ADR 0031, plan Step 2).
#
# Every new flag value arrives as type=str and is validated HERE, with
# re.fullmatch over explicit ASCII classes (never str.isdigit, never int()/
# float() coercion of an unvalidated string). A refusal is one `sbx: error:`
# line through _usage_error (exit 2); the one exception is the cwd rule of
# validate_restricted, which is a containment refusal (exit 3). No function here
# touches the filesystem -- resolve_reads / linux_base_reads below are the only
# readers, called from main() only (P1). An --env VALUE is never echoed on any
# path (sbx_restrict:D2): a refusal names the key or the entry's position.

_ENV_KEY_RE = r"[A-Za-z_][A-Za-z0-9_]{0,127}"
_ENV_REFUSED_PREFIXES = ("LD_", "DYLD_")
_ENV_MAX_ENTRIES = 64
_ENV_MAX_VALUE_CHARS = 32768

_DECIMAL_RE = r"[0-9]{1,20}"
_NPROC_PLUS_RE = r"\+[0-9]{1,5}"
_TIMEOUT_RE = r"[0-9]{1,6}(\.[0-9]{1,3})?"
_STATUS_FD_RE = r"[0-9]{1,4}"
_TIMEOUT_MAX_S = 86400

_READ_CAP = 256
_EXEC_CAP = 32

# (flag suffix, resource name, minimum, maximum) -- the strict --rlimit-* table.
_RLIMIT_SPECS = (
    ("as", "RLIMIT_AS", 64 * 1024 ** 2, 2 ** 62),
    ("cpu", "RLIMIT_CPU", 1, 86400),
    ("nproc", "RLIMIT_NPROC", 1, 1000000),
    ("fsize", "RLIMIT_FSIZE", 0, 2 ** 62),
    ("nofile", "RLIMIT_NOFILE", 3, 1048576),
    ("core", "RLIMIT_CORE", 0, 2 ** 62),
)
_NPROC_HEADROOM_MAX = 4096


def parse_env(raw, clean):
    """`--env KEY=VALUE` entries -> the exact target environment (a dict), or
    None when `--clean-env` was not given (inherit, the legacy behaviour).

    `--env` without `--clean-env` is refused: a pair on top of an inherited
    environment would silently mix the two. Keys follow `_ENV_KEY_RE` (so no key
    can start with `-` -- the darwin `/usr/bin/env -i` trampoline, KD-5); the
    LD_ and DYLD_ prefixes are refused (loader injection); a duplicate key is
    refused rather than last-wins; a value carries no NUL and at most 32768
    characters; at most 64 entries. Values are NEVER echoed (D2).
    """
    raw = list(raw or ())
    if not clean:
        if raw:
            _usage_error("--env requires --clean-env")
        return None
    if len(raw) > _ENV_MAX_ENTRIES:
        _usage_error("too many --env entries (%d > %d)"
                     % (len(raw), _ENV_MAX_ENTRIES))
    env = {}
    for index, spec in enumerate(raw, 1):
        key, sep, value = spec.partition("=")
        if not sep or not re.fullmatch(_ENV_KEY_RE, key, re.ASCII):
            _usage_error("--env entry #%d: the key must match ^%s$ and be "
                         "followed by '=' (value not echoed)"
                         % (index, _ENV_KEY_RE))
        if key.startswith(_ENV_REFUSED_PREFIXES):
            _usage_error("--env %s: the LD_ and DYLD_ prefixes are refused "
                         "(loader injection)" % (key,))
        if key in env:
            _usage_error("--env %s: duplicate key" % (key,))
        if "\x00" in value:
            _usage_error("--env %s: the value contains a NUL (value not "
                         "echoed)" % (key,))
        if len(value) > _ENV_MAX_VALUE_CHARS:
            _usage_error("--env %s: the value exceeds %d characters"
                         % (key, _ENV_MAX_VALUE_CHARS))
        env[key] = value
    return env


def parse_limits(args):
    """The strict `--rlimit-*` flags -> (limits, nproc_headroom).

    `limits` is a tuple of `(resource name, int)` pairs in the fixed
    `_RLIMIT_SPECS` order, one per flag given. Each value is plain decimal
    (`^[0-9]{1,20}$`) inside its range: AS >= 64 MiB, CPU 1..86400, NPROC
    1..1000000, FSIZE 0..2**62, NOFILE 3..1048576, CORE 0..2**62. NPROC also
    takes `+N` (`^\\+[0-9]{1,5}$`, 1..4096): N processes ABOVE the uid's
    current count, returned as `nproc_headroom` and resolved to an absolute in
    the supervisor -- it never yields an RLIMIT_NPROC pair here.
    """
    limits = []
    headroom = None
    for suffix, name, low, high in _RLIMIT_SPECS:
        raw = getattr(args, "rlimit_" + suffix, None)
        if raw is None:
            continue
        flag = "--rlimit-" + suffix
        if suffix == "nproc" and re.fullmatch(_NPROC_PLUS_RE, raw, re.ASCII):
            value = int(raw[1:])
            if not 1 <= value <= _NPROC_HEADROOM_MAX:
                _usage_error("%s %r: the +N headroom must be 1..%d"
                             % (flag, raw, _NPROC_HEADROOM_MAX))
            headroom = value
            continue
        if not re.fullmatch(_DECIMAL_RE, raw, re.ASCII):
            _usage_error("%s %r: not a plain decimal integer" % (flag, raw[:32]))
        value = int(raw)
        if not low <= value <= high:
            _usage_error("%s %s: out of range %d..%d" % (flag, raw, low, high))
        limits.append((name, value))
    return tuple(limits), headroom


def parse_timeout(raw):
    """`--timeout SECONDS` -> float, or None when absent. Decimal with at most
    three fraction digits (`^[0-9]{1,6}(\\.[0-9]{1,3})?$`, so no sign, exponent,
    `nan` or `inf`), and 0 < t <= 86400."""
    if raw is None:
        return None
    if not re.fullmatch(_TIMEOUT_RE, raw, re.ASCII):
        _usage_error("--timeout %r: not a decimal number of seconds" % (raw[:32],))
    value = float(raw)
    if not 0 < value <= _TIMEOUT_MAX_S:
        _usage_error("--timeout %s: must be > 0 and <= %d"
                     % (raw, _TIMEOUT_MAX_S))
    return value


def parse_status_fd(raw, timeout):
    """`--status-fd FD` -> int, or None when absent. Requires `--timeout` (only
    the supervisor writes a status record); `^[0-9]{1,4}$` and >= 3 (0-2 are
    the target's stdio)."""
    if raw is None:
        return None
    if timeout is None:
        _usage_error("--status-fd requires --timeout")
    if not re.fullmatch(_STATUS_FD_RE, raw, re.ASCII):
        _usage_error("--status-fd %r: not a decimal fd number" % (raw[:32],))
    value = int(raw)
    if value < 3:
        _usage_error("--status-fd %d: must be >= 3 (0-2 are the target's stdio)"
                     % (value,))
    return value


def parse_egress_port(raw):
    """`--egress-port N` -> int, or None when absent: plain ASCII decimal
    (`^[0-9]{1,5}$`, so no sign, space or non-ASCII digit) in 1..65535;
    anything else exit 2."""
    if raw is None:
        return None
    if not re.fullmatch(_EGRESS_PORT_RE, raw, re.ASCII) \
            or not 1 <= int(raw) <= 65535:
        _usage_error("--egress-port %r: not a port 1..65535" % (raw[:32],))
    return int(raw)


def validate_egress(args, platform_key):
    """The egress flags -> (egress_port, egress_socket spelling), both None
    when neither was given.

    Usage errors (exit 2): both flags together; either without
    --restrict-reads (the endpoint is a hole in the restricted network deny
    and means nothing on the legacy profile); either beside --net (which
    opens everything); a malformed port; a relative or metacharacter-bearing
    socket path (canonicalize_read's floor). Platform refusals (exit 3):
    --egress-port anywhere but darwin (bwrap's private netns cannot reach a
    host port) and --egress-socket anywhere but linux (Seatbelt takes the
    TCP endpoint). Pure: the socket itself is checked by
    egress_socket_refusal, from main() only."""
    port_raw = getattr(args, "egress_port", None)
    sock_raw = getattr(args, "egress_socket", None)
    if port_raw is None and sock_raw is None:
        return None, None
    if port_raw is not None and sock_raw is not None:
        _usage_error("--egress-port and --egress-socket are mutually exclusive")
    if not args.restrict_reads:
        _usage_error("--egress-port / --egress-socket require --restrict-reads")
    if args.net:
        _usage_error("--egress-port / --egress-socket cannot be combined with "
                     "--net")
    if port_raw is not None:
        port = parse_egress_port(port_raw)
        if platform_key != "darwin":
            _containment_refusal(
                "--egress-port is the Seatbelt (macOS) endpoint; a bwrap "
                "run's private network namespace cannot reach a host port "
                "(use --egress-socket)")
        return port, None
    path = canonicalize_read(sock_raw)
    if platform_key != "linux":
        _containment_refusal(
            "--egress-socket is the bwrap (Linux) endpoint; Seatbelt takes "
            "--egress-port")
    return None, path


def _private_group(gid, euid):
    """Is `gid` a user-private group of `euid`? -> True only when its group
    entry names no member but the euid's user and no passwd entry but the
    euid's own has it as primary group. An unknown gid or euid -> False
    (fail closed). I/O: the grp and pwd databases."""
    try:
        me = pwd.getpwuid(euid).pw_name
        members = grp.getgrgid(gid).gr_mem
    except KeyError:
        return False
    if any(m != me for m in members):
        return False
    return not any(p.pw_gid == gid and p.pw_uid != euid
                   for p in pwd.getpwall())


def egress_socket_refusal(path):
    """May `path` be bound into the sandbox as its egress endpoint? -> None,
    or the refusal reason.

    The ONE explicit exception to "no socket reaches a restricted run", so
    it is narrow: the path must be absolute, normalized and its own realpath
    (no symlink hop anywhere -- the bind source is resolved again by bwrap),
    lie under no socket directory (SOCKET_REFUSED_DIRS, as spelled and as
    realpath'd -- /run/docker.sock, a D-Bus or agent socket), be a socket
    (lstat), owned by the euid, in a directory owned by the euid with no
    group or other bits (0700: nobody else can swap it). I/O: lstat and
    realpath, called from main() only."""
    if not isinstance(path, str) or not path.startswith("/") \
            or any(ch in _INJECT_CHARS for ch in path):
        return "%r is not an absolute, metacharacter-free path" % (path,)
    if os.path.normpath(path) != path or os.path.realpath(path) != path:
        return ("%r is not its own realpath (a symlink hop or a non-normal "
                "spelling)" % (path,))
    for d in SOCKET_REFUSED_DIRS:
        for sock_dir in {d, os.path.realpath(d)}:
            if _covered(path, sock_dir):
                return "%r lies under the socket directory %s" % (path,
                                                                  sock_dir)
    try:
        st = os.lstat(path)
        parent = os.lstat(os.path.dirname(path))
    except OSError as exc:
        return "%r: %s" % (path, exc.strerror or exc)
    if not stat.S_ISSOCK(st.st_mode):
        return "%r is not a socket" % (path,)
    euid = os.geteuid()
    if st.st_uid != euid:
        return "%r is not owned by the current user" % (path,)
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != euid \
            or parent.st_mode & 0o077:
        return ("%r: its directory must be the current user's own, mode "
                "0700" % (path,))
    # Every ancestor above that directory, up to "/": bwrap resolves the
    # bind source again at mount time, so an ancestor another uid may write
    # lets that uid rename the 0700 directory away in between. Each must be
    # owned by root or the euid with no other write bit, and a group write
    # bit only for the euid's user-private group (umask 0002 under UPG makes
    # every user dir 0775; that group has nobody else in it) -- or be a
    # root-owned sticky directory (/tmp), where nobody renames what is not
    # theirs.
    anc = os.path.dirname(os.path.dirname(path))
    while True:
        try:
            a = os.lstat(anc)
        except OSError as exc:
            return "%r: %s: %s" % (path, anc, exc.strerror or exc)
        sticky_root = a.st_uid == 0 and a.st_mode & stat.S_ISVTX
        if not stat.S_ISDIR(a.st_mode) or a.st_uid not in (0, euid):
            return ("%r: its ancestor %s is not a directory owned by root "
                    "or the current user" % (path, anc))
        if a.st_mode & 0o002 and not sticky_root:
            return ("%r: its ancestor %s is world-writable (writable by "
                    "another user)" % (path, anc))
        if a.st_mode & 0o020 and not sticky_root \
                and not _private_group(a.st_gid, euid):
            return ("%r: its ancestor %s is group-writable by a shared group "
                    "(writable by another user)" % (path, anc))
        if anc == "/":
            return None
        anc = os.path.dirname(anc)


def egress_python(bound, reads):
    """The forwarder's interpreter for an `--egress-socket` run -> sbx's own
    realpath, or None when it would not be visible inside the restricted
    root: it AND its stdlib prefix (sys.base_prefix) must lie under a
    linux_base bind (the `("ro-bind", p)` entries of `bound`) or a `--read`
    grant -- /usr/bin/python3 and /usr on a distribution python. No new read
    is ever added for it: bwrap has no exec filter to widen, and the read
    set stays the caller's. I/O: realpath only."""
    exe = os.path.realpath(sys.executable or "")
    prefix = os.path.realpath(sys.base_prefix or "")
    if not exe.startswith("/") or not prefix.startswith("/"):
        return None
    grants = [entry[1] for entry in bound if entry[0] == "ro-bind"]
    grants += [rule[0] for rule in reads if rule[1] in ("dir", "file")]
    if all(any(_covered(p, g) for g in grants) for p in (exe, prefix)):
        return exe
    return None


def _containment_refusal(msg):
    """One `sbx: error:` line and exit 3 -- a request sbx cannot honour
    here, never run in a weaker form."""
    sys.stderr.write("sbx: error: %s\n" % (msg,))
    sys.exit(3)


def metadata_ancestors(paths):
    """Every PROPER ancestor (including "/") of every absolute path given --
    the read spellings, write scopes, exec paths and the cwd -- deduplicated
    and sorted. These become LITERAL file-read-metadata allows: path lookup
    needs to stat each component, and a global metadata rule would make the
    whole filesystem's shape an oracle (sbx_restrict:E4). A non-absolute entry
    (a bare argv0 name) has no ancestors and is skipped. Pure."""
    found = set()
    for path in paths or ():
        if not isinstance(path, str) or not path.startswith("/"):
            continue
        cur = os.path.normpath(path)
        while True:
            parent = os.path.dirname(cur)
            if parent == cur:            # reached "/"
                break
            found.add(parent)
            cur = parent
    return tuple(sorted(found))


def validate_restricted(args, argv0, cwd, writes):
    """The cross-flag rules of restricted mode, applied after parsing:
      * `--read` / `--exec` without `--restrict-reads` -> exit 2 (a read grant
        is meaningless on the read-anywhere baseline, and silently so);
      * `--restrict-reads` with `--net` -> exit 2 (restricted mode is the
        no-network runner mode);
      * with `--clean-env`, argv0 must be ABSOLUTE (nothing in an empty env can
        resolve a bare name) -> exit 2; on darwin it must not contain `=`,
        because the `/usr/bin/env -i K=V ... <argv0>` trampoline would read it
        as one more assignment (KD-5) -> exit 2;
      * restricted mode needs the cwd INSIDE a write scope or a `--read` scope
        (the target could not even stat its own working directory otherwise)
        -> one stderr line, exit 3.
    Pure: `writes` is the already-canonicalized write set; the `--read`
    spellings are canonicalized here with canonicalize_read (no I/O)."""
    if (args.read or args.exec) and not args.restrict_reads:
        _usage_error("--read and --exec require --restrict-reads")
    if args.restrict_reads and args.net:
        _usage_error("--restrict-reads cannot be combined with --net")
    if args.clean_env:
        if not argv0.startswith("/"):
            _usage_error("--clean-env requires an absolute command path "
                         "(got %r)" % (argv0,))
        if sys.platform == "darwin" and "=" in argv0:
            _usage_error("--clean-env: the command path must not contain '=' "
                         "(the env -i trampoline would read it as an assignment)")
    if not args.restrict_reads:
        return
    here = os.path.normpath(cwd)
    scopes = list(writes or ()) + [canonicalize_read(p) for p in args.read]
    for scope in scopes:
        if inside_project(here, os.path.normpath(scope)):
            return
    sys.stderr.write(
        "sbx: error: --restrict-reads: the working directory %r is inside no "
        "write or read scope; refusing to run (fail-closed)\n" % (cwd,))
    sys.exit(3)


# ---------------------------------------------------------------------------
# Restricted mode: the I/O resolvers (P1). Like secret_paths, these are the
# ONLY places restricted mode touches the filesystem, and they run only from
# main() and only when a restricted flag asks for them -- a legacy invocation
# calls neither. The builders consume their pure tuples.

# bwrap's restricted base filesystem: the system trees (a usr-merge symlink is
# re-created as a symlink, never followed) and the few /etc entries the dynamic
# loader, TLS and the clock need.
_LINUX_BASE_DIRS = ("/usr", "/lib", "/lib64", "/lib32", "/bin", "/sbin")
_LINUX_BASE_ETC = ("/etc/ld.so.cache", "/etc/ld.so.conf", "/etc/ld.so.conf.d",
                   "/etc/localtime", "/etc/ssl/certs", "/etc/alternatives")


_SYMLINK_HOPS_MAX = 40        # the kernel's own MAXSYMLINKS order of magnitude


def socket_read_refusal(spelling):
    """P2 (CWE-41): may the `--read` / `--exec` `spelling` be granted? -> None,
    or the refusal reason.

    The bwrap builder refused a spelling under a socket directory, but on the
    SPELLING only: a symlink elsewhere pointing at /run, or `/var/run/...` (a
    symlink to /run that was not in the list), was ro-bound past the tmpfs --
    and a read-only bind does not stop connect() on a socket (the host docker
    socket). So, platform-neutral: every hop of the spelling's symlink chain
    is checked as spelled AND as realpath'd, then the final realpath, against
    SOCKET_REFUSED_DIRS, and a target that IS a socket (S_ISSOCK) is refused
    wherever it lives. A chain longer than _SYMLINK_HOPS_MAX hops is refused.

    I/O (lstat / readlink / realpath / stat), called from resolve_reads only.
    On darwin the realpath of a system path is /private/..., so this refuses
    only what is spelled into the list or is a socket -- Seatbelt's (deny
    network*) already denies unix-socket connect there; the check is the same
    code on both OSes so it is gated on both."""
    def _under(path):
        return any(_covered(path, d) for d in SOCKET_REFUSED_DIRS)

    def _why(path):
        return ("%r resolves under a socket directory (%s) the sandbox hides "
                "(via %r)" % (spelling, ", ".join(SOCKET_REFUSED_DIRS), path))

    cur = spelling
    for _hop in range(_SYMLINK_HOPS_MAX):
        for path in (os.path.normpath(cur), os.path.realpath(cur)):
            if _under(path):
                return _why(path)
        try:
            st = os.lstat(cur)
        except OSError:
            break                         # a dangling hop: the realpath below
        if not stat.S_ISLNK(st.st_mode):
            break
        cur = os.path.join(os.path.dirname(cur), os.readlink(cur))
    else:
        return "%r: more than %d symlink hops" % (spelling, _SYMLINK_HOPS_MAX)
    real = os.path.realpath(spelling)
    if _under(real):
        return _why(real)
    try:
        if stat.S_ISSOCK(os.stat(real).st_mode):
            return "%r resolves to a socket (%r)" % (spelling, real)
    except OSError:
        pass                              # nothing there: no socket to reach
    return None


def resolve_reads(reads, execs, argv0):
    """Classify every `--read` and `--exec` spelling -> (read_rules, exec_rules).

    Each `--read` spelling is canonicalize_read()'d (absolute, injection floor,
    normpath, NEVER realpath -- KD-14) and `os.lstat`ed, so the link itself is
    classified, not its target: a symlink -> `(p, "symlink", os.readlink(p))`
    (a LITERAL, with the link value the bwrap builder re-creates), a directory
    -> `(p, "dir", None)` (a subpath), anything else -> `(p, "file", None)`.
    A missing or unreadable spelling is refused (exit 2) -- a grant of nothing
    is a caller bug. No chain is walked into the RULES: the caller passes every
    hop it needs. The chain IS walked for one check only (P2): a read or exec
    spelling that resolves -- at any hop or finally -- under a socket directory,
    or to a socket, is refused (exit 2, socket_read_refusal); the rule keeps
    the spelling either way.

    `exec_rules` is the argv0 spelling (when absolute; a bare name has no path
    the filter could match) followed by each `--exec` entry as
    `(spelling, is_dir)`; an `--exec` entry must exist too. Caps: at most 256
    reads and 32 execs (exit 2). Duplicates collapse to their first spelling.
    """
    reads = list(reads or ())
    execs = list(execs or ())
    if len(reads) > _READ_CAP:
        _usage_error("too many --read entries (%d > %d)" % (len(reads), _READ_CAP))
    if len(execs) > _EXEC_CAP:
        _usage_error("too many --exec entries (%d > %d)" % (len(execs), _EXEC_CAP))

    def _lstat(path, flag):
        try:
            st = os.lstat(path)
        except OSError as exc:
            _usage_error("%s %r: %s" % (flag, path, exc.strerror or exc))
        reason = socket_read_refusal(path)   # P2: every hop + the realpath
        if reason is not None:
            _usage_error("refusing %s %s" % (flag, reason))
        return st

    read_rules, seen = [], set()
    for raw in reads:
        path = canonicalize_read(raw)
        if path in seen:
            continue
        seen.add(path)
        st = _lstat(path, "--read")
        if stat.S_ISLNK(st.st_mode):
            read_rules.append((path, "symlink", os.readlink(path)))
        elif stat.S_ISDIR(st.st_mode):
            read_rules.append((path, "dir", None))
        else:
            read_rules.append((path, "file", None))

    exec_rules, seen = [], set()
    if argv0.startswith("/"):
        if any(ch in _INJECT_CHARS for ch in argv0):
            _usage_error("refusing command path %r: it contains a shell/SBPL "
                         "metacharacter (one of \" ' ( ) \\ or a control "
                         "character)" % (argv0,))
        exec_rules.append((argv0, False))
        seen.add(argv0)
    for raw in execs:
        path = canonicalize_read(raw)
        if path in seen:
            continue
        seen.add(path)
        _lstat(path, "--exec")
        # the type bit only (a usr-merged /bin is a symlink to a directory);
        # the spelling itself is kept, never resolved (KD-14)
        exec_rules.append((path, os.path.isdir(path)))
    return tuple(read_rules), tuple(exec_rules)


def linux_base_reads():
    """The bwrap base filesystem of restricted mode, in argv order (Linux only).

    For each of /usr, /lib, /lib64, /lib32, /bin, /sbin: a symlink (usr-merge)
    -> `("symlink", os.readlink(p), p)`, a directory -> `("ro-bind", p)`,
    absent -> skipped. Then the /etc set (ld.so.cache, ld.so.conf,
    ld.so.conf.d, localtime, ssl/certs, alternatives), existence-filtered the
    same way (a symlinked entry such as /etc/localtime is re-created as a
    symlink, never followed) and skipped when a base bind already covers its
    spelling. bwrap cannot mkdir a mountpoint for a missing source, so the
    filter is what keeps the argv valid on every distribution.
    """
    entries, bound = [], []
    for path in _LINUX_BASE_DIRS + _LINUX_BASE_ETC:
        if any(inside_project(path, b) for b in bound):
            continue
        try:
            st = os.lstat(path)
        except OSError:
            continue
        if stat.S_ISLNK(st.st_mode):
            entries.append(("symlink", os.readlink(path), path))
        elif path in _LINUX_BASE_DIRS and not stat.S_ISDIR(st.st_mode):
            continue
        else:
            entries.append(("ro-bind", path))
            bound.append(path)
    return tuple(entries)


def _restricted_flags_given(args):
    """True when ANY restricted-mode flag is on the command line. A legacy
    invocation (none) keeps the exact pre-ADR-0031 call sequence in main()."""
    if (args.restrict_reads or args.read or args.exec or args.clean_env
            or args.env or args.timeout is not None
            or args.status_fd is not None
            or getattr(args, "egress_port", None) is not None
            or getattr(args, "egress_socket", None) is not None):
        return True
    return any(getattr(args, "rlimit_" + suffix, None) is not None
               for suffix, _name, _low, _high in _RLIMIT_SPECS)


def _format_plan(scope):
    """Human-readable dump of the resolved Scope for --dry-run. The restricted
    fields are appended only when a restricted flag set them, so a legacy plan
    is unchanged; the environment is shown as its KEYS only -- a value is never
    printed (sbx_restrict:D2)."""
    lines = [
        "sbx plan -- resolved request (no child executed)",
        "  engine      : %r" % (scope.engine,),
        "  writes      : %r" % (scope.writes,),
        "  net         : %r" % (scope.net,),
        "  ro          : %r" % (scope.ro,),
        "  argv        : %r" % (scope.argv,),
        "  secret_paths: %r" % (scope.secret_paths,),
        "  carveouts   : %r" % (scope.carveouts,),
        "  shadow_write_denies: %r" % (scope.shadow_write_denies,),
        "  seccomp     : %r" % (scope.seccomp,),
    ]
    if scope.egress_port is not None or scope.egress_socket is not None:
        lines += [
            "  egress_port : %r" % (scope.egress_port,),
            "  egress_socket: %r" % (scope.egress_socket,),
            "  egress_python: %r" % (scope.egress_python,),
        ]
    if (scope.restrict_reads or scope.read_rules or scope.exec_rules
            or scope.env is not None or scope.timeout is not None
            or scope.status_fd is not None or scope.limits
            or scope.nproc_headroom is not None):
        env_keys = None if scope.env is None else sorted(scope.env)
        lines += [
            "  restrict_reads: %r" % (scope.restrict_reads,),
            "  read_rules  : %r" % (scope.read_rules,),
            "  meta_literals: %r" % (scope.meta_literals,),
            "  exec_rules  : %r" % (scope.exec_rules,),
            "  linux_base  : %r" % (scope.linux_base,),
            "  env (keys only; values never printed): %r" % (env_keys,),
            "  timeout     : %r" % (scope.timeout,),
            "  status_fd   : %r" % (scope.status_fd,),
            "  limits      : %r" % (scope.limits,),
            "  nproc_headroom: %r" % (scope.nproc_headroom,),
        ]
    return "\n".join(lines)


def _usage_error(msg):
    """Write a one-line reason + usage to stderr and exit non-zero (P4 house style)."""
    sys.stderr.write("sbx: error: %s\n%s\n" % (msg, USAGE))
    sys.exit(2)


# ---------------------------------------------------------------------------
# Linux seccomp syscall filter (R-0003): `--seccomp`.
#
# bwrap's namespaces, read-only bind and unshared network are the Linux boundary;
# they do not shrink the KERNEL surface a contained process can call into. This
# adds a classic-BPF seccomp program that bwrap installs in the target right
# before exec (`bwrap --seccomp FD`). Built here with struct alone -- no
# libseccomp binding (ADR 0024) -- as pure module-level data plus one pure
# builder; the only I/O (the memfd that carries it to bwrap) is _seccomp_fd(),
# called from main(), so _bwrap_argv stays a pure Scope -> argv function.
#
# ALLOWLIST, not denylist (the user's decision): a syscall nobody listed -- every
# one the kernel adds after this table was written -- is DENIED. The default
# action is ERRNO(EPERM), not KILL: a program probing an optional call sees a
# clean error it already handles, instead of dying. KILL_PROCESS is reserved for
# the two cases that can only be an evasion attempt: a foreign audit arch (e.g.
# i386 `int 0x80` from a 64-bit process, whose numbers mean different calls) and
# the x32 bit, which reaches the same handlers under numbers this table never
# checks.
#
# x86_64 ONLY. Syscall numbers are per-architecture; no other table is embedded,
# because the numbers could not be sourced and verified here, and an invented
# number is a hole. On any other machine seccomp_program() refuses, and sbx
# refuses to run with --seccomp rather than run without it (fail-closed).
#
# The numbers are copied from /usr/include/x86_64-linux-gnu/asm/unistd_64.h on an
# Ubuntu 24.04 host (linux-libc-dev 6.8.0-38.38, sha256 e34e39ab...809fe). The
# x86_64 syscall ABI is append-only, so they cannot change under a newer kernel;
# the suite checks every one against an independent copy of that header.
# ---------------------------------------------------------------------------

# AUDIT_ARCH_* for the machines a table exists for (uname -m -> audit arch).
_AUDIT_ARCH = {"x86_64": 0xC000003E}

# The x86_64 numbers of every syscall the program names: the plain allowlist
# below plus the four argument-checked or rerouted entries (socket, ioctl, clone,
# clone3). Grouped by purpose; what is NOT here is denied.
_SECCOMP_X86_64 = {
    # files, directories, descriptors
    "read": 0, "write": 1, "open": 2, "close": 3, "stat": 4, "fstat": 5,
    "lstat": 6, "poll": 7, "lseek": 8, "pread64": 17, "pwrite64": 18,
    "readv": 19, "writev": 20, "access": 21, "pipe": 22, "select": 23,
    "dup": 32, "dup2": 33, "sendfile": 40, "fcntl": 72, "flock": 73,
